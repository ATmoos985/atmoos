---
interface Props {
  side: 'left' | 'right'
  label: string
}
const { side, label } = Astro.props
---

<details class='reader-sidebar' data-reader-sidebar={side} data-label={label} open>
  <summary aria-label={`收起${label}`} title={`收起${label}`}>
    <span class='sidebar-label'>{label}</span>
    <svg class='sidebar-icon' viewBox='0 0 20 20' width='18' height='18' aria-hidden='true'>
      <rect x='2.5' y='3.5' width='15' height='13' rx='1'></rect>
      <path d={side === 'left' ? 'M7 3.5v13m6-10-3 3 3 3' : 'M13 3.5v13m-6-10 3 3-3 3'}></path>
    </svg>
  </summary>
  <div class='sidebar-body'><slot /></div>
</details>

<style>
  .reader-sidebar {
    position: sticky;
    top: 1.5rem;
    min-width: 0;
    margin-top: 1.5rem;
    max-height: calc(100dvh - 3rem);
    overflow: auto;
    scrollbar-width: thin;
  }
  [data-reader-sidebar='left'] {
    grid-area: navigation;
  }
  [data-reader-sidebar='right'] {
    grid-area: contents;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.4rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.04);
  }
  summary:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
  .sidebar-icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .sidebar-body {
    padding-top: 1rem;
  }
  [data-reader-sidebar='left'][open] {
    padding-right: 1rem;
    border-right: 1px solid hsl(var(--border) / 0.7);
  }
  [data-reader-sidebar='right'][open] {
    padding-left: 1rem;
    border-left: 1px solid hsl(var(--border) / 0.7);
  }
  .reader-sidebar:not([open]) > summary {
    flex-direction: column-reverse;
    gap: 0.75rem;
    padding: 0.55rem 0.4rem;
  }
  .reader-sidebar:not([open]) .sidebar-label {
    writing-mode: vertical-rl;
    letter-spacing: 0.18em;
  }
  .reader-sidebar:not([open]) .sidebar-icon {
    transform: rotate(180deg);
  }
  @media (max-width: 1100px) {
    .reader-sidebar {
      position: static;
      margin-top: 0;
      max-height: none;
      border-bottom: 1px solid hsl(var(--border));
    }
    [data-reader-sidebar='left'][open],
    [data-reader-sidebar='right'][open] {
      padding: 0;
      border-left: 0;
      border-right: 0;
    }
    summary,
    .reader-sidebar:not([open]) > summary {
      flex-direction: row;
      padding: 0.85rem 0;
    }
    .reader-sidebar:not([open]) .sidebar-label {
      writing-mode: horizontal-tb;
      letter-spacing: 0;
    }
    .sidebar-body {
      max-height: 55dvh;
      overflow: auto;
      padding: 0.25rem 0 1rem;
    }
  }
  @media print {
    .reader-sidebar {
      display: none;
    }
  }
</style>
