---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { docsSeries } from '@/data/docs'

import { cn } from 'astro-pure/utils'

export const prerender = true

type Props = {
  title?: boolean
  compact?: boolean
  series?: string
  section?: string
  class?: string
}

const {
  title = true,
  compact = false,
  series: selectedSeries,
  section: selectedSection,
  class: className,
  ...props
} = Astro.props

const docsCollection = (await getCollection(
  'docs',
  ({ data }) => !data.draft
)) as CollectionEntry<'docs'>[]
const currentPath = Astro.url.pathname
const isCurrentPath = (id: string) => currentPath === `/docs/${id}`

const trees = docsSeries
  .filter((series) => !selectedSeries || series.id === selectedSeries)
  .map((series) => {
    const seriesDocs = docsCollection.filter((doc) => doc.data.series === series.id)
    const overview = seriesDocs.find((doc) => doc.data.isIndex && !doc.data.section)
    const sections = series.sections.map((section) => {
      const index = seriesDocs.find((doc) => doc.data.section === section.id && doc.data.isIndex)
      const docs = seriesDocs
        .filter((doc) => doc.data.section === section.id && !doc.data.isIndex)
        .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))

      return {
        ...section,
        index,
        docs,
        isCurrent:
          selectedSection === section.id ||
          (index ? isCurrentPath(index.id) : false) ||
          docs.some((doc) => isCurrentPath(doc.id))
      }
    })
    return { ...series, overview, sections }
  })
---

<nav
  class={cn('docs-ledger not-prose', compact && 'compact', className)}
  {...props}
  aria-label='笔记目录'
>
  {
    title && (
      <div class='ledger-heading'>
        <p class='mono-label'>Notebook index</p>
        <h2>笔记目录</h2>
      </div>
    )
  }

  {
    trees.map((series) => (
      <section class='ledger-series' aria-labelledby={`ledger-series-${series.id}`}>
        {compact ? (
          <div class='ledger-context'>
            <span>{series.number}</span>
            <strong id={`ledger-series-${series.id}`}>{series.shortTitle}</strong>
            {series.overview && (
              <a
                class:list={{ current: isCurrentPath(series.overview.id) }}
                href={`/docs/${series.overview.id}`}
                aria-current={isCurrentPath(series.overview.id) ? 'page' : undefined}
              >
                总索引
              </a>
            )}
          </div>
        ) : (
          <div class='ledger-series-head'>
            <span>{series.number}</span>
            <div>
              <h3 id={`ledger-series-${series.id}`}>{series.shortTitle}</h3>
              <p>{series.summary}</p>
            </div>
            {series.overview && (
              <a
                class:list={['overview-link', { current: isCurrentPath(series.overview.id) }]}
                href={`/docs/${series.overview.id}`}
                aria-current={isCurrentPath(series.overview.id) ? 'page' : undefined}
              >
                总索引 →
              </a>
            )}
          </div>
        )}

        <ol class='ledger-sections'>
          {series.sections.map((section) => (
            <li class:list={['ledger-section', { current: section.isCurrent }]}>
              <details class='ledger-group' open={!compact || section.isCurrent}>
                <summary class='ledger-section-head'>
                  <span>{section.number}</span>
                  <strong>{section.title}</strong>
                  <small>{section.docs.length}</small>
                  <span class='ledger-toggle' aria-hidden='true' />
                </summary>

                <div class='ledger-section-body'>
                  {!compact && <p class='ledger-section-summary'>{section.summary}</p>}
                  <ol class='ledger-docs'>
                    {section.index && (
                      <li class='index-note'>
                        <a
                          class:list={{ current: isCurrentPath(section.index.id) }}
                          href={`/docs/${section.index.id}`}
                          aria-current={isCurrentPath(section.index.id) ? 'page' : undefined}
                        >
                          <span>00</span>
                          <strong>{section.index.data.title}</strong>
                        </a>
                      </li>
                    )}
                    {section.docs.map((doc) => (
                      <li>
                        <a
                          class:list={{ current: isCurrentPath(doc.id) }}
                          href={`/docs/${doc.id}`}
                          aria-current={isCurrentPath(doc.id) ? 'page' : undefined}
                        >
                          <span>{String(doc.data.order).padStart(2, '0')}</span>
                          <strong>{doc.data.title}</strong>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</nav>

<style>
  .ledger-heading {
    margin-bottom: 1.2rem;
  }

  .ledger-heading p {
    margin: 0;
    color: hsl(var(--primary));
  }

  .ledger-heading h2 {
    margin: 0.35rem 0 0;
    font-family: var(--display-font);
    font-size: 1.65rem;
    font-weight: 500;
  }

  .ledger-series + .ledger-series {
    margin-top: 3rem;
  }

  .ledger-series-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--border));
  }

  .ledger-series-head > span {
    color: hsl(var(--primary));
    font-family: var(--display-font);
    font-size: 2rem;
    line-height: 1;
  }

  .ledger-series-head h3 {
    margin: 0;
    font-family: var(--display-font);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .ledger-series-head p {
    margin: 0.25rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }

  .overview-link {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.68rem;
  }

  .overview-link.current,
  .overview-link:hover {
    color: hsl(var(--primary));
  }

  .ledger-context {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-top: 1px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--border));
  }

  .ledger-context > span,
  .ledger-context a {
    font-family: var(--mono-font);
    font-size: 0.63rem;
  }

  .ledger-context > span,
  .ledger-context a.current,
  .ledger-context a:hover {
    color: hsl(var(--primary));
  }

  .ledger-context strong {
    color: hsl(var(--foreground));
    font-family: var(--display-font);
    font-size: 1rem;
    font-weight: 500;
  }

  .ledger-context a {
    color: hsl(var(--muted-foreground));
  }

  .ledger-sections,
  .ledger-docs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ledger-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-left: 1px solid hsl(var(--border));
  }

  .ledger-section {
    min-width: 0;
    padding: 1.2rem;
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--card) / 0.24);
  }

  .ledger-group summary {
    cursor: pointer;
    list-style: none;
  }

  .ledger-group summary::-webkit-details-marker {
    display: none;
  }

  .ledger-group summary:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 0.35rem;
  }

  .ledger-section-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.7rem;
    align-items: baseline;
  }

  .ledger-section-head > span,
  .ledger-section-head > small {
    font-family: var(--mono-font);
    font-size: 0.63rem;
  }

  .ledger-section-head > span {
    color: hsl(var(--primary));
  }

  .ledger-section-head > small {
    color: hsl(var(--muted-foreground));
  }

  .ledger-section-head strong {
    color: hsl(var(--foreground));
    font-family: var(--display-font);
    font-size: 1.12rem;
    font-weight: 500;
  }

  .ledger-section.current .ledger-section-head strong {
    color: hsl(var(--primary));
  }

  .ledger-toggle {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    align-self: center;
  }

  .ledger-toggle::before,
  .ledger-toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.65rem;
    height: 1px;
    content: '';
    background: hsl(var(--muted-foreground));
    transform: translate(-50%, -50%);
    transition: transform 160ms ease;
  }

  .ledger-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .ledger-group[open] .ledger-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .ledger-section-summary {
    min-height: 2.6rem;
    margin: 0.45rem 0 0.85rem 1.45rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    line-height: 1.6;
  }

  .ledger-docs {
    margin-top: 0.8rem;
    border-top: 1px solid hsl(var(--border));
  }

  .ledger-docs a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    padding: 0.58rem 0;
    border-bottom: 1px solid hsl(var(--border) / 0.7);
    color: hsl(var(--muted-foreground));
  }

  .ledger-docs a:hover,
  .ledger-docs a.current {
    color: hsl(var(--foreground));
  }

  .ledger-docs a.current {
    padding-left: 0.55rem;
    background: hsl(var(--muted) / 0.42);
    box-shadow: inset 2px 0 0 hsl(var(--primary));
  }

  .ledger-docs .index-note a {
    color: hsl(var(--foreground));
  }

  .ledger-docs .index-note span {
    color: hsl(var(--muted-foreground));
  }

  .ledger-docs span {
    padding-top: 0.05rem;
    color: hsl(var(--primary));
    font-family: var(--mono-font);
    font-size: 0.58rem;
  }

  .ledger-docs strong {
    overflow: hidden;
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .docs-ledger.compact .ledger-sections {
    display: block;
    border-left: 0;
  }

  .docs-ledger.compact .ledger-section {
    padding: 0;
    border: 0;
    border-bottom: 1px solid hsl(var(--border));
    background: transparent;
  }

  .docs-ledger.compact .ledger-section-head {
    padding: 0.78rem 0.2rem;
  }

  .docs-ledger.compact .ledger-section.current .ledger-section-head {
    padding-left: 0.65rem;
    background: hsl(var(--muted) / 0.32);
    box-shadow: inset 2px 0 0 hsl(var(--primary));
  }

  .docs-ledger.compact .ledger-section-head strong {
    font-family: var(--body-font);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .docs-ledger.compact .ledger-docs {
    margin-top: 0;
    padding: 0.2rem 0 0.45rem 0.65rem;
    border-top: 1px solid hsl(var(--border) / 0.72);
    background: hsl(var(--card) / 0.18);
  }

  .docs-ledger.compact .ledger-docs a {
    padding-block: 0.52rem;
  }

  @media (max-width: 720px) {
    .ledger-sections {
      grid-template-columns: 1fr;
    }
  }
</style>
