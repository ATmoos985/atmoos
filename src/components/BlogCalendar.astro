---
import { blogFilterUrl, monthDays, publicationDay, shiftMonth } from '@/data/calendar'

interface Props {
  month: string
  activeDate: string
  activeTag: string
  counts: Map<string, number>
}
const { month, activeDate, activeTag, counts } = Astro.props
const [year, number] = month.split('-').map(Number)
const today = publicationDay(new Date())
const previous = shiftMonth(month, -1)
const next = shiftMonth(month, 1)
const days = monthDays(month)
const monthUrl = (value: string) =>
  blogFilterUrl({ month: value, date: activeDate, tag: activeTag })
---

<aside class='calendar-sidebar' aria-label='按发布日期筛选'>
  <div class='calendar'>
    <div class='calendar-heading'>
      <h2>{year} 年 {number} 月</h2>
      <div class='month-controls'>
        {
          previous && (
            <a href={monthUrl(previous)} aria-label='上个月'>
              ‹
            </a>
          )
        }
        {
          next && (
            <a href={monthUrl(next)} aria-label='下个月'>
              ›
            </a>
          )
        }
      </div>
    </div>
    <table aria-label={`${year} 年 ${number} 月发布日历`}>
      <thead
        ><tr
          >{['一', '二', '三', '四', '五', '六', '日'].map((day) => <th scope='col'>{day}</th>)}</tr
        ></thead
      >
      <tbody>
        {
          Array.from({ length: days.length / 7 }, (_, week) => (
            <tr>
              {days.slice(week * 7, week * 7 + 7).map((date) => (
                <td
                  data-today={date === today || undefined}
                  data-selected={date === activeDate || undefined}
                >
                  {date &&
                    (counts.has(date) ? (
                      <a
                        href={blogFilterUrl({ date, month, tag: activeTag })}
                        aria-label={`${date}，${counts.get(date)} 篇文章`}
                        aria-current={date === activeDate ? 'true' : undefined}
                      >
                        {Number(date.slice(-2))}
                        <span class='publication-dot' aria-hidden='true' />
                      </a>
                    ) : (
                      <span>{Number(date.slice(-2))}</span>
                    ))}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class='calendar-caption'>
      <span><i aria-hidden='true'></i> 有文章的日子</span><a href={monthUrl(today.slice(0, 7))}
        >本月</a>
    </div>
    <a
      class='all-dates'
      href={blogFilterUrl({ tag: activeTag })}
      aria-current={!activeDate ? 'true' : undefined}>全部日期 <span>→</span></a
    >
  </div>
</aside>
<style>
  .calendar-sidebar {
    min-width: 0;
  }
  .calendar {
    position: sticky;
    top: 2rem;
    max-width: 18rem;
  }
  .calendar-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }
  h2 {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .month-controls {
    display: flex;
    gap: 0.2rem;
  }
  .month-controls a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 1.25rem;
  }
  a:hover {
    color: hsl(var(--primary));
    background: hsl(var(--muted) / 0.5);
  }
  table {
    table-layout: fixed;
    width: 100%;
    border-collapse: collapse;
  }
  th {
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
    font-weight: 400;
    padding-bottom: 0.5rem;
  }
  td {
    padding: 0.12rem 0;
    text-align: center;
    font-family: var(--mono-font);
    font-size: 0.75rem;
  }
  td > a,
  td > span {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 2.2rem;
  }
  td > span {
    color: hsl(var(--muted-foreground));
    opacity: 0.7;
  }
  td[data-today] > :is(a, span) {
    box-shadow: inset 0 0 0 1px hsl(var(--border));
  }
  td[data-selected] > a {
    color: hsl(var(--background));
    background: hsl(var(--primary));
  }
  .publication-dot {
    position: absolute;
    bottom: 0.2rem;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    color: hsl(var(--primary));
  }
  td[data-selected] .publication-dot {
    color: inherit;
  }
  .calendar-caption {
    display: flex;
    justify-content: space-between;
    margin-top: 0.9rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .calendar-caption span {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
  .all-dates {
    display: flex;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding-block: 0.65rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.75rem;
  }
  .all-dates[aria-current] {
    color: hsl(var(--primary));
  }
  @media (max-width: 700px) {
    .calendar {
      position: static;
      max-width: 20rem;
    }
  }
</style>
