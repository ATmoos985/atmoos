---
import { blogFilterUrl, monthDays, publicationDay, shiftMonth } from '@/data/calendar'

interface Props {
  month: string
  activeDate: string
  activeTag: string
  counts: Map<string, number>
}
const { month, activeDate, activeTag, counts } = Astro.props
const [year, number] = month.split('-').map(Number)
const today = publicationDay(new Date())
const previous = shiftMonth(month, -1)
const next = shiftMonth(month, 1)
const days = monthDays(month)
const latest = [...counts.keys()].sort().at(-1)
const monthUrl = (value: string) => blogFilterUrl({ month: value, tag: activeTag })
const dateUrl = (date: string) => blogFilterUrl({ date, month: date.slice(0, 7), tag: activeTag })
---

<aside class='calendar-sidebar' aria-label='按发布日期筛选'>
  <div class='calendar'>
    <div class='calendar-heading'>
      {
        previous ? (
          <a class='month-arrow' href={monthUrl(previous)} aria-label='上个月' title='上个月'>
            ‹
          </a>
        ) : (
          <span class='month-arrow' />
        )
      }
      <form action='/blog' method='get' class='month-jump' aria-label='选择年月' data-month-jump>
        {activeTag && <input type='hidden' name='tag' value={activeTag} />}
        <input
          type='number'
          name='year'
          value={year}
          min='1000'
          max='9999'
          step='1'
          required
          aria-label='年份'
          title='输入年份'
        />
        <select name='monthNumber' aria-label='月份'>
          {
            Array.from({ length: 12 }, (_, index) => (
              <option value={String(index + 1).padStart(2, '0')} selected={index + 1 === number}>
                {index + 1} 月
              </option>
            ))
          }
        </select>
        <button type='submit' title='查看所选月份'>跳转</button>
      </form>
      {
        next ? (
          <a class='month-arrow' href={monthUrl(next)} aria-label='下个月' title='下个月'>
            ›
          </a>
        ) : (
          <span class='month-arrow' />
        )
      }
    </div>
    <table aria-label={`${year} 年 ${number} 月发布日历`}>
      <thead
        ><tr
          >{['一', '二', '三', '四', '五', '六', '日'].map((day) => <th scope='col'>{day}</th>)}</tr
        ></thead
      >
      <tbody>
        {
          Array.from({ length: days.length / 7 }, (_, week) => (
            <tr>
              {days.slice(week * 7, week * 7 + 7).map((date) => (
                <td
                  data-today={date === today || undefined}
                  data-selected={date === activeDate || undefined}
                >
                  {date && (
                    <a
                      href={dateUrl(date)}
                      aria-label={`${date}，${counts.get(date) ?? 0} 篇文章${date === today ? '，今天' : ''}`}
                      title={`${date} · ${counts.get(date) ?? 0} 篇文章${date === today ? ' · 今天' : ''}`}
                      data-has-posts={counts.has(date) || undefined}
                      aria-current={date === activeDate ? 'true' : undefined}
                    >
                      {Number(date.slice(-2))}
                      {counts.has(date) && <span class='publication-dot' aria-hidden='true' />}
                    </a>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class='calendar-footer'>
      <span class='calendar-legend' title='圆点表示当天有文章'
        ><i aria-hidden='true'></i> 有文章</span
      >
      <nav aria-label='日期快捷筛选'>
        <a href={dateUrl(today)} title='查看今天的文章'>今天</a>
        {
          latest && (
            <a href={dateUrl(latest)} title={`最近发布于 ${latest}`}>
              最近
            </a>
          )
        }
        <a
          href={blogFilterUrl({ tag: activeTag })}
          aria-label='全部日期'
          aria-current={!activeDate ? 'true' : undefined}>全部</a
        >
      </nav>
    </div>
  </div>
</aside>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-month-jump]').forEach((form) => {
    form.querySelector('select')?.addEventListener('change', () => form.requestSubmit())
  })
</script>
<style>
  .calendar-sidebar {
    min-width: 0;
  }
  .calendar {
    position: sticky;
    top: 2rem;
    max-width: 15.25rem;
  }
  .calendar-heading {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) 1.75rem;
    align-items: center;
    gap: 0.1rem;
    margin-bottom: 0.45rem;
  }
  .month-jump {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-width: 0;
    margin: 0;
  }
  .month-jump input,
  .month-jump select,
  .month-jump button {
    height: 1.85rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: hsl(var(--foreground));
    font-size: 0.75rem;
  }
  .month-jump input {
    width: 3.4rem;
    font-family: var(--mono-font);
    text-align: center;
    appearance: textfield;
    border-bottom: 1px solid hsl(var(--border) / 0.6);
  }
  .month-jump input::-webkit-inner-spin-button,
  .month-jump input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }
  .month-jump select {
    width: 3.4rem;
    cursor: pointer;
  }
  .month-jump button {
    padding-inline: 0.15rem;
    font-size: 0.67rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    cursor: pointer;
  }
  .month-arrow {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.85rem;
    font-size: 1.1rem;
  }
  a:hover,
  button:hover {
    color: hsl(var(--primary));
    background: hsl(var(--muted) / 0.5);
  }
  table {
    table-layout: fixed;
    width: 100%;
    border-collapse: collapse;
  }
  th {
    height: 1.5rem;
    font-size: 0.67rem;
    color: hsl(var(--muted-foreground));
    font-weight: 400;
    padding: 0;
  }
  td {
    height: 1.8rem;
    padding: 0;
    text-align: center;
    font-family: var(--mono-font);
    font-size: 0.75rem;
  }
  td > a {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 1.8rem;
    color: hsl(var(--muted-foreground));
  }
  td > a[data-has-posts] {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  td[data-today] > a {
    box-shadow: inset 0 0 0 1px hsl(var(--border));
  }
  td[data-selected] > a {
    color: hsl(var(--background));
    background: hsl(var(--primary));
  }
  .publication-dot {
    position: absolute;
    bottom: 0.12rem;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    color: hsl(var(--primary));
  }
  td[data-selected] .publication-dot {
    color: inherit;
  }
  .calendar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    margin-top: 0.5rem;
    padding-top: 0.4rem;
    border-top: 1px solid hsl(var(--border) / 0.65);
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .calendar-legend {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
  .calendar-footer nav {
    display: flex;
    gap: 0.6rem;
  }
  .calendar-footer a {
    display: inline-block;
    padding-block: 0.25rem;
  }
  i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
  .calendar-footer a[aria-current] {
    color: hsl(var(--primary));
  }
  @media (max-width: 700px) {
    .calendar {
      position: static;
    }
    td,
    td > a {
      height: 2rem;
    }
  }
</style>
