---
import type { ActivityItem } from '@/data/activity'

interface Props {
  activity: ActivityItem[]
}

const { activity } = Astro.props
const initialDate = activity[0]?.latestDate ?? new Date().toISOString().slice(0, 10)
const initialMonth = initialDate.slice(0, 7)

const formatMonth = (month: string) => {
  const [year, monthNumber] = month.split('-').map(Number)
  return new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(
    new Date(year, monthNumber - 1, 1)
  )
}

const calendarActivity = activity.map(({ id, title, href, kind, kindLabel, events }) => ({
  id,
  title,
  href,
  kind,
  kindLabel,
  events
}))
---

<section
  class='calendar-panel'
  id='activity-calendar'
  data-calendar
  data-initial-month={initialMonth}
  data-initial-date={initialDate}
  aria-labelledby='calendar-title'
>
  <header class='panel-head calendar-head'>
    <div>
      <p class='mono-label'>Activity calendar</p>
      <h2 id='calendar-title' class='editorial-title'>{formatMonth(initialMonth)}</h2>
    </div>
    <div class='calendar-controls' aria-label='切换月份'>
      <button type='button' data-calendar-prev aria-label='上一个月'>←</button>
      <button type='button' data-calendar-next aria-label='下一个月'>→</button>
    </div>
  </header>
  <p class='panel-intro'>有色圆点代表当天有上传或更新，点击日期查看当天发生了什么。</p>
  <div class='calendar-weekdays' aria-hidden='true'>
    <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span
      >六</span
    >
  </div>
  <div class='calendar-grid' data-calendar-grid role='grid' aria-label='活动日历'></div>
  <div class='calendar-legend'><i aria-hidden='true'></i><span>有上传或更新</span></div>
  <section class='calendar-detail' aria-live='polite' aria-labelledby='calendar-detail-title'>
    <header>
      <div>
        <p class='mono-label'>Selected date</p>
        <h3 id='calendar-detail-title' data-calendar-selected-date>选择一个日期</h3>
      </div>
      <span data-calendar-selected-count>—</span>
    </header>
    <ol data-calendar-details></ol>
  </section>
</section>

<script
  id='calendar-activity-data'
  type='application/json'
  is:inline
  set:html={JSON.stringify(calendarActivity).replace(/</g, '\\u003c')}
/>

<script>
  type CalendarActivity = {
    id: string
    title: string
    href: string
    kind: 'note' | 'essay'
    kindLabel: string
    events: { date: string; action: string }[]
  }

  type CalendarEntry = { item: CalendarActivity; action: string }

  const calendar = document.querySelector<HTMLElement>('[data-calendar]')
  const dataNode = document.querySelector<HTMLScriptElement>('#calendar-activity-data')

  if (calendar && dataNode) {
    const activities: CalendarActivity[] = JSON.parse(dataNode.textContent ?? '[]')
    const monthTitle = calendar.querySelector<HTMLElement>('#calendar-title')
    const grid = calendar.querySelector<HTMLElement>('[data-calendar-grid]')
    const selectedDateLabel = calendar.querySelector<HTMLElement>('[data-calendar-selected-date]')
    const selectedCount = calendar.querySelector<HTMLElement>('[data-calendar-selected-count]')
    const detailList = calendar.querySelector<HTMLOListElement>('[data-calendar-details]')
    const eventsByDate = new Map<string, CalendarEntry[]>()

    activities.forEach((item) => {
      item.events.forEach((event) => {
        const entries = eventsByDate.get(event.date) ?? []
        entries.push({ item, action: event.action })
        eventsByDate.set(event.date, entries)
      })
    })

    const pad = (value: number) => String(value).padStart(2, '0')
    const monthFromDate = (date: string) => date.slice(0, 7)
    const monthLabel = (month: string) => {
      const [year, monthNumber] = month.split('-').map(Number)
      return new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(
        new Date(year, monthNumber - 1, 1)
      )
    }
    const dateLabel = (date: string) =>
      new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        weekday: 'short'
      }).format(new Date(`${date}T12:00:00`))

    let displayedMonth = calendar.dataset.initialMonth ?? ''
    let selectedDate = calendar.dataset.initialDate ?? ''

    const selectDate = (date: string) => {
      selectedDate = date
      calendar.querySelectorAll<HTMLButtonElement>('.calendar-day').forEach((day) => {
        day.classList.toggle('selected', day.dataset.date === selectedDate)
        day.setAttribute('aria-pressed', String(day.dataset.date === selectedDate))
      })
      renderDetails()
    }

    const renderDetails = () => {
      const entries = eventsByDate.get(selectedDate) ?? []
      if (selectedDateLabel) selectedDateLabel.textContent = dateLabel(selectedDate)
      if (selectedCount)
        selectedCount.textContent = entries.length ? `${entries.length} 项` : '没有记录'
      if (!detailList) return
      detailList.replaceChildren()

      if (!entries.length) {
        const empty = document.createElement('li')
        empty.className = 'calendar-detail-empty'
        empty.textContent = '这一天没有公开上传或更新记录。'
        detailList.append(empty)
        return
      }

      const grouped = new Map<string, { item: CalendarActivity; actions: string[] }>()
      entries.forEach(({ item, action }) => {
        const current = grouped.get(item.id) ?? { item, actions: [] }
        current.actions.push(action)
        grouped.set(item.id, current)
      })

      grouped.forEach(({ item, actions }) => {
        const entry = document.createElement('li')
        const link = document.createElement('a')
        link.href = item.href

        const type = document.createElement('span')
        type.className = `calendar-item-type ${item.kind}`
        type.textContent = item.kindLabel

        const copy = document.createElement('span')
        copy.className = 'calendar-item-copy'
        const title = document.createElement('strong')
        title.textContent = item.title
        const meta = document.createElement('small')
        meta.textContent = `${actions.join(' · ')} · 打开内容 →`
        copy.append(title, meta)
        link.append(type, copy)
        entry.append(link)
        detailList.append(entry)
      })
    }

    const renderCalendar = () => {
      const [year, monthNumber] = displayedMonth.split('-').map(Number)
      const firstDay = new Date(year, monthNumber - 1, 1).getDay()
      const daysInMonth = new Date(year, monthNumber, 0).getDate()
      if (monthTitle) monthTitle.textContent = monthLabel(displayedMonth)
      if (!grid) return
      grid.replaceChildren()

      for (let index = 0; index < firstDay; index += 1) {
        const empty = document.createElement('span')
        empty.className = 'calendar-empty'
        empty.setAttribute('aria-hidden', 'true')
        grid.append(empty)
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = `${displayedMonth}-${pad(day)}`
        const hasActivity = eventsByDate.has(date)
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'calendar-day'
        button.dataset.date = date
        button.setAttribute('role', 'gridcell')
        button.setAttribute('aria-label', `${dateLabel(date)}${hasActivity ? '，有活动' : ''}`)
        button.setAttribute('aria-pressed', String(date === selectedDate))
        if (hasActivity) button.classList.add('has-activity')
        if (date === selectedDate) button.classList.add('selected')

        const number = document.createElement('span')
        number.textContent = String(day)
        button.append(number)
        if (hasActivity) {
          const dot = document.createElement('i')
          dot.setAttribute('aria-hidden', 'true')
          button.append(dot)
        }
        button.addEventListener('click', () => selectDate(date))
        grid.append(button)
      }
    }

    const moveMonth = (offset: number) => {
      const [year, monthNumber] = displayedMonth.split('-').map(Number)
      const next = new Date(year, monthNumber - 1 + offset, 1)
      displayedMonth = `${next.getFullYear()}-${pad(next.getMonth() + 1)}`
      const monthDates = [...eventsByDate.keys()]
        .filter((date) => monthFromDate(date) === displayedMonth)
        .sort()
      selectedDate = monthDates[0] ?? `${displayedMonth}-01`
      renderCalendar()
      renderDetails()
    }

    calendar.querySelector('[data-calendar-prev]')?.addEventListener('click', () => moveMonth(-1))
    calendar.querySelector('[data-calendar-next]')?.addEventListener('click', () => moveMonth(1))
    renderCalendar()
    renderDetails()
  }
</script>

<style>
  .calendar-panel {
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.5rem);
    background: hsl(var(--background));
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .panel-head .mono-label {
    margin: 0 0 0.55rem;
    color: hsl(var(--primary));
    font-size: 0.6rem;
  }

  .panel-head h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1;
  }

  .panel-intro {
    margin: 1rem 0 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .calendar-head {
    align-items: center;
  }

  .calendar-controls {
    display: flex;
    gap: 0.35rem;
  }

  .calendar-controls button {
    display: grid;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    place-items: center;
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    background: transparent;
    font-family: var(--mono-font);
    font-size: 0.62rem;
  }

  .calendar-controls button:hover,
  .calendar-controls button:focus-visible {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .calendar-weekdays,
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .calendar-weekdays {
    margin-top: 0.35rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.58rem;
    text-align: center;
  }

  .calendar-weekdays span {
    padding: 0.5rem 0;
  }

  .calendar-grid {
    border-top: 1px solid hsl(var(--border));
    border-left: 1px solid hsl(var(--border));
  }

  .calendar-empty,
  .calendar-day {
    min-height: 2.8rem;
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
  }

  .calendar-empty {
    display: block;
    background: hsl(var(--muted) / 0.2);
  }

  .calendar-day {
    position: relative;
    display: grid;
    cursor: pointer;
    place-items: center;
    padding: 0;
    border-top: 0;
    border-left: 0;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    font-family: var(--mono-font);
    font-size: 0.66rem;
  }

  .calendar-day:hover {
    z-index: 1;
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.58);
  }

  .calendar-day.selected {
    z-index: 2;
    outline: 2px solid hsl(var(--primary));
    outline-offset: -2px;
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.78);
  }

  .calendar-day.has-activity {
    color: hsl(var(--foreground));
    font-weight: 700;
  }

  .calendar-day i,
  .calendar-legend i {
    display: block;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: hsl(var(--primary));
  }

  .calendar-day i {
    position: absolute;
    bottom: 0.32rem;
  }

  .calendar-legend {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.58rem;
  }

  .calendar-detail {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid hsl(var(--foreground));
  }

  .calendar-detail header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .calendar-detail header > span {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.62rem;
  }

  .calendar-detail header p {
    margin: 0 0 0.35rem;
    color: hsl(var(--primary));
    font-size: 0.58rem;
  }

  .calendar-detail h3 {
    margin: 0;
    font-family: var(--display-font);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .calendar-detail ol {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .calendar-detail li {
    border-top: 1px solid hsl(var(--border));
  }

  .calendar-detail li a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
    padding: 0.65rem 0;
    color: hsl(var(--foreground));
  }

  .calendar-detail li a:hover {
    color: hsl(var(--primary));
  }

  .calendar-item-type {
    padding: 0.16rem 0.3rem;
    color: hsl(var(--primary));
    background: hsl(var(--muted));
    font-family: var(--mono-font);
    font-size: 0.54rem;
  }

  .calendar-item-type.essay {
    color: var(--accent-cool);
  }

  .calendar-item-copy {
    min-width: 0;
  }

  .calendar-item-copy strong,
  .calendar-item-copy small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .calendar-item-copy strong {
    font-size: 0.72rem;
    font-weight: 600;
  }

  .calendar-item-copy small {
    margin-top: 0.18rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.58rem;
  }

  .calendar-detail-empty {
    padding: 0.8rem 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }

  @media (max-width: 620px) {
    .calendar-day,
    .calendar-empty {
      min-height: 2.45rem;
    }
  }
</style>
