---
interface Props {
  action: string
  tags: string[]
  activeTag: string
  count: number
}
const { action, tags, activeTag, count } = Astro.props
---

<div class='content-toolbar'>
  <form {action} method='get' class='tag-filter'>
    <label for='tag'>标签</label>
    <select id='tag' name='tag'>
      <option value='' selected={!activeTag}>全部标签</option>
      {
        activeTag && !tags.includes(activeTag) && (
          <option value={activeTag} selected>
            {activeTag}
          </option>
        )
      }
      {
        tags.map((tag) => (
          <option value={tag} selected={activeTag === tag}>
            {tag}
          </option>
        ))
      }
    </select>
    <button type='submit'>筛选</button>
    {
      activeTag && (
        <a class='text-link' href={action}>
          清除
        </a>
      )
    }
  </form>
  <p class='post-count'>{count} 篇</p>
</div>
{
  activeTag && (
    <p class='filter-summary'>
      标签：<strong>{activeTag}</strong>
    </p>
  )
}

<style>
  .content-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 1rem;
    border-bottom: 1px solid hsl(var(--border) / 0.65);
  }
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    font-size: 0.76rem;
  }
  .tag-filter label,
  .post-count {
    color: hsl(var(--muted-foreground));
  }
  .tag-filter select {
    width: 10rem;
    max-width: 58vw;
    padding: 0.45rem 0.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0;
    background: transparent;
    color: hsl(var(--foreground));
    font: inherit;
  }
  .tag-filter button {
    padding: 0.45rem 0.7rem;
    border: 1px solid hsl(var(--foreground));
    border-radius: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .tag-filter button:hover {
    background: hsl(var(--muted));
  }
  .post-count {
    margin: 0;
    font-size: 0.72rem;
  }
  .filter-summary {
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }
  .filter-summary strong {
    font-weight: 500;
    color: hsl(var(--primary));
  }
</style>
