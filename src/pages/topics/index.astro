---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { docsSeries } from '@/data/docs'

import BaseLayout from '@/layouts/BaseLayout.astro'

const timefoldSeries = docsSeries.find((series) => series.id === 'timefold')

if (!timefoldSeries) {
  throw new Error('Timefold docs series is not configured.')
}

const docs = (await getCollection('docs', ({ data }) => !data.draft)) as CollectionEntry<'docs'>[]
const seriesDocs = docs.filter((note) => note.data.series === timefoldSeries.id)

const topicGroups = timefoldSeries.sections.map((section) => {
  const notes = seriesDocs
    .filter((note) => note.data.section === section.id && !note.data.isIndex)
    .sort((a, b) => a.data.order - b.data.order)
  const index = seriesDocs.find((note) => note.data.section === section.id && note.data.isIndex)
  const first = notes[0]

  return {
    ...section,
    count: notes.length,
    href: index ? `/docs/${index.id}` : first ? `/docs/${first.id}` : '/docs',
    entryLabel: index ? '打开章节索引' : first ? '从首篇开始' : '查看笔记目录'
  }
})

const totalNotes = topicGroups.reduce((sum, group) => sum + group.count, 0)
---

<BaseLayout
  meta={{
    title: '专题',
    description: '按求解流程组织的 Timefold Solver 公开笔记专题。'
  }}
  highlightColor={timefoldSeries.color}
>
  <main class='topics-page' aria-labelledby='topics-title'>
    <header class='topics-head animate' id='content-header'>
      <div class='folio' aria-hidden='true'>TOPICS—01</div>
      <div class='headline'>
        <p class='eyebrow'>{timefoldSeries.eyebrow}</p>
        <h1 id='topics-title'>六个工作面，<br />一条求解路径。</h1>
        <p class='lede'>
          Timefold
          笔记按真实求解流程拆成六组：先配置运行，再建模、写约束，最后进入算法、实验与调优。
        </p>
      </div>
      <dl class='issue-stats' aria-label='专题统计'>
        <div>
          <dt>分组</dt>
          <dd>{topicGroups.length.toString().padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>正文</dt>
          <dd>{totalNotes.toString().padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>状态</dt>
          <dd class='status'>持续整理</dd>
        </div>
      </dl>
    </header>

    <section class='topic-ledger animate' id='content' aria-labelledby='ledger-title'>
      <div class='ledger-rule'>
        <h2 id='ledger-title'>{timefoldSeries.shortTitle}</h2>
        <span>{topicGroups.length} GROUPS / {totalNotes} NOTES</span>
      </div>

      <ol class='topic-grid'>
        {
          topicGroups.map((group) => (
            <li>
              <a href={group.href}>
                <div class='card-meta'>
                  <span>{group.number}</span>
                  <span>{group.count.toString().padStart(2, '0')} 篇正文</span>
                </div>
                <h3>{group.title}</h3>
                <p>{group.summary}</p>
                <div class='card-entry'>
                  <span>{group.entryLabel}</span>
                  <span aria-hidden='true'>↗</span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <footer class='topics-foot'>
      <span>PUBLIC NOTEBOOK / 2026.07</span>
      <a href='/docs'>查看完整笔记目录 →</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .topics-page {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 4rem);
  }

  .topics-head {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 13rem;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    border-block: 1px solid hsl(var(--foreground) / 0.78);
  }

  .folio,
  .eyebrow,
  .issue-stats,
  .ledger-rule,
  .card-meta,
  .card-entry,
  .topics-foot {
    font-family: var(--mono-font);
  }

  .folio {
    align-self: start;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: hsl(var(--primary));
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display-font);
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.3rem, 4.2vw, 4rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .lede {
    max-width: 42rem;
    margin: 1.6rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .issue-stats {
    margin: 0;
    font-size: 0.68rem;
  }

  .issue-stats > div {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.72rem;
    border-top: 1px solid hsl(var(--border));
  }

  .issue-stats > div:last-child {
    border-bottom: 1px solid hsl(var(--border));
  }

  .issue-stats dt {
    color: hsl(var(--muted-foreground));
  }

  .issue-stats dd {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 0.86rem;
  }

  .issue-stats .status {
    color: hsl(var(--primary));
    font-size: 0.7rem;
  }

  .topic-ledger {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .ledger-rule {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid hsl(var(--foreground));
  }

  .ledger-rule h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.8vw, 2.2rem);
    font-weight: 500;
  }

  .ledger-rule span {
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid hsl(var(--border));
  }

  .topic-grid li {
    min-width: 0;
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
  }

  .topic-grid a {
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    color: hsl(var(--foreground));
    background: hsl(var(--card) / 0.28);
    text-decoration: none;
  }

  .topic-grid a:hover,
  .topic-grid a:focus-visible {
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.62);
  }

  .topic-grid a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: -2px;
  }

  .card-meta,
  .card-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .card-meta span:first-child {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .card-meta span:last-child {
    color: hsl(var(--muted-foreground));
  }

  .topic-grid h3 {
    margin: clamp(2.2rem, 4vw, 3.5rem) 0 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .topic-grid p {
    margin: 1rem 0 2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .card-entry {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid hsl(var(--border));
  }

  .card-entry span:last-child {
    color: hsl(var(--primary));
    font-size: 1rem;
  }

  .topics-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .topics-foot a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  @media (max-width: 1180px) {
    .topics-head {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .issue-stats {
      grid-column: 2;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .issue-stats > div {
      display: block;
      padding: 0.8rem 1rem;
      border-bottom: 1px solid hsl(var(--border));
    }

    .issue-stats > div + div {
      border-left: 1px solid hsl(var(--border));
    }

    .issue-stats dd {
      margin-top: 0.3rem;
    }

    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .topics-page {
      padding-top: 1.5rem;
    }

    .topics-head {
      display: block;
    }

    .folio {
      margin-bottom: 2rem;
    }

    h1 {
      font-size: clamp(2.35rem, 10vw, 3.2rem);
    }

    .issue-stats {
      display: grid;
      margin-top: 2rem;
    }

    .ledger-rule {
      align-items: flex-end;
    }

    .ledger-rule span {
      max-width: 10rem;
      text-align: right;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topic-grid a {
      min-height: 17rem;
    }

    .topics-foot {
      flex-direction: column;
    }
  }
</style>
