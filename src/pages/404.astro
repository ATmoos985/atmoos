---
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true
---

<PageLayout meta={{ description: '页面不存在', title: '404' }}>
  <main id='main-content' class='missing-page'>
    <p class='eyebrow'>404</p>
    <h1 class='editorial-title'>这一页还没有写下。</h1>
    <p>链接可能已经移动，试着从首页或博客继续阅读。</p>
    <nav aria-label='返回站点'>
      <a class='text-link' href='/'>返回首页</a>
      <a class='text-link' href='/blog'>查看博客 →</a>
    </nav>
  </main>
</PageLayout>

<style>
  .missing-page {
    padding: 5rem 0;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.4;
  }
  .missing-page > p:not(.eyebrow) {
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }
  nav {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    font-size: 0.9rem;
  }
</style>
