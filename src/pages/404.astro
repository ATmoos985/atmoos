---
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ description: '页面不存在', title: '404' }}>
  <main class='not-found'>
    <div class='error-code editorial-title'>404</div>
    <div class='error-copy'>
      <p class='mono-label'>Missing sheet / no record</p>
      <h1 class='editorial-title'>这页不在公开档案里。</h1>
      <p>链接可能已经移动，或内容仍留在未公开的笔记中。</p>
      <div>
        <a class='note-button' href='/docs'>查看笔记目录 →</a>
        <a class='note-button secondary' href='/'>返回首页</a>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: center;
    min-height: 62vh;
    padding: 3rem 0 5rem;
  }

  .error-code {
    color: hsl(var(--primary));
    font-size: clamp(8rem, 22vw, 17rem);
    line-height: 0.72;
  }

  .error-copy {
    padding: 2rem 0;
    border-top: 1px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--foreground));
  }

  .error-copy > .mono-label {
    color: hsl(var(--primary));
  }

  h1 {
    margin: 1rem 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .error-copy > p:not(.mono-label) {
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }

  .error-copy > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 720px) {
    .not-found {
      grid-template-columns: 1fr;
    }
  }
</style>
