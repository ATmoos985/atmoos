---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'

const essays = (await getCollection('blog', ({ data }) => !data.draft)) as CollectionEntry<'blog'>[]
const orderedEssays = [...essays].sort(
  (a, b) =>
    (b.data.updatedDate?.valueOf() ?? b.data.publishDate.valueOf()) -
    (a.data.updatedDate?.valueOf() ?? a.data.publishDate.valueOf())
)

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).format(date)
---

<PageLayout
  meta={{
    title: '随笔',
    description: 'Ami 的个人随笔与非教程文字。只发布真实内容，不用模板填充。'
  }}
  highlightColor='#2f7771'
>
  <main class='essays-index'>
    <header class='essays-hero animate' id='content-header'>
      <div>
        <p class='mono-label'>Personal writing / 002</p>
        <h1 class='editorial-title'>随笔不负责整理知识。<br />它只留下当时的想法。</h1>
      </div>
      <div class='essays-intro'>
        <p>
          这里和技术笔记分开，收录更个人、更松散、也不一定会变成教程的文字。内容只从真实稿件生成，暂时没有文章时会诚实地保持空白。
        </p>
        <span class='essays-status'
          ><i aria-hidden='true'></i>{orderedEssays.length} 篇公开随笔</span
        >
      </div>
    </header>

    {
      orderedEssays.length ? (
        <ol class='essay-list animate' id='content'>
          {orderedEssays.map((essay, index) => (
            <li>
              <a href={`/essays/${essay.id}`}>
                <span class='essay-number'>{String(index + 1).padStart(2, '0')}</span>
                <span class='essay-copy'>
                  <strong>{essay.data.title}</strong>
                  <small>{essay.data.description}</small>
                </span>
                <time datetime={(essay.data.updatedDate ?? essay.data.publishDate).toISOString()}>
                  {formatDate(essay.data.updatedDate ?? essay.data.publishDate)}
                </time>
                <span class='essay-arrow' aria-hidden='true'>
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <section class='essays-empty animate' id='content' aria-label='随笔空状态'>
          <span class='empty-mark' aria-hidden='true'>
            W—00
          </span>
          <div>
            <p class='mono-label'>No public essays yet</p>
            <h2 class='editorial-title'>这里暂时没有随笔。</h2>
            <p>随笔区已经准备好，但只会在有真实文字时出现内容。</p>
          </div>
        </section>
      )
    }
  </main>
</PageLayout>

<style>
  .essays-index {
    padding: 2rem 0 1rem;
  }

  .essays-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding: 1.75rem 0 2.75rem;
    border-bottom: 1px solid hsl(var(--foreground));
  }

  .essays-hero .mono-label {
    margin: 0 0 1.2rem;
    color: var(--accent-cool);
  }

  .essays-hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.2rem, 3.6vw, 3.6rem);
    line-height: 1;
  }

  .essays-intro > p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.9;
  }

  .essays-status {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1.4rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.62rem;
  }

  .essays-status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-cool);
    box-shadow: 0 0 0 4px hsl(var(--muted) / 0.85);
  }

  .essay-list {
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid hsl(var(--foreground));
    list-style: none;
  }

  .essay-list li {
    border-bottom: 1px solid hsl(var(--border));
  }

  .essay-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1.35rem 0;
    color: hsl(var(--foreground));
  }

  .essay-list a:hover {
    padding-left: 0.45rem;
    color: hsl(var(--foreground));
  }

  .essay-number,
  .essay-list time,
  .essay-arrow {
    color: var(--accent-cool);
    font-family: var(--mono-font);
    font-size: 0.64rem;
  }

  .essay-copy {
    min-width: 0;
  }

  .essay-copy strong,
  .essay-copy small {
    display: block;
  }

  .essay-copy strong {
    font-family: var(--display-font);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .essay-copy small {
    margin-top: 0.35rem;
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .essay-list time {
    color: hsl(var(--muted-foreground));
  }

  .essays-empty {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin-top: 4rem;
    padding: 2rem 0 5rem;
    border-top: 1px solid hsl(var(--foreground));
  }

  .empty-mark {
    color: var(--accent-cool);
    font-family: var(--mono-font);
    font-size: 0.7rem;
  }

  .essays-empty .mono-label {
    margin: 0 0 0.6rem;
    color: var(--accent-cool);
  }

  .essays-empty h2 {
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 3rem);
  }

  .essays-empty p:last-child {
    max-width: 30rem;
    margin: 1rem 0 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .essays-hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 620px) {
    .essays-hero h1 {
      font-size: clamp(2.35rem, 10vw, 3.2rem);
    }

    .essay-list a {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .essay-list time {
      grid-column: 2;
      grid-row: 2;
      margin-top: -0.35rem;
    }

    .essay-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .essays-empty {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
