---
import { getCollection } from 'astro:content'
import { buildActivityItems } from '@/data/activity'

import PageLayout from '@/layouts/BaseLayout.astro'

const [docs, essays] = await Promise.all([
  getCollection('docs', ({ data }) => !data.draft),
  getCollection('blog', ({ data }) => !data.draft)
])

const activity = buildActivityItems(docs, essays)
const recentActivity = activity.slice(0, 6)
const noteCount = docs.filter(({ data }) => !data.isIndex).length
const essayCount = essays.length

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit'
  }).format(new Date(`${date}T12:00:00`))

const entries = [
  { code: '01', title: '笔记', note: `${noteCount} 篇公开技术记录`, href: '/docs', mark: '↗' },
  {
    code: '02',
    title: '随笔',
    note: essayCount ? `${essayCount} 篇个人文字` : '等待真实内容',
    href: '/essays',
    mark: '↗'
  },
  { code: '03', title: 'CV', note: '已确认的个人资料', href: '/cv', mark: '→' },
  { code: '04', title: '专题', note: '沿知识路径浏览', href: '/topics', mark: '↗' },
  { code: '05', title: '项目', note: '公开项目与实践', href: '/projects', mark: '↗' },
  { code: '06', title: '近况', note: '此刻关注什么', href: '/now', mark: '→' },
  { code: '07', title: '关于', note: '边界与整理方式', href: '/about', mark: '→' }
]
---

<PageLayout
  meta={{
    title: '首页',
    description: 'Ami 的个人入口：CV、公开笔记、随笔与持续更新记录。'
  }}
  highlightColor='#d65a34'
>
  <main class='home-page'>
    <header class='home-hero animate' id='content-header'>
      <div class='hero-copy'>
        <p class='mono-label hero-eyebrow'>个人入口</p>
        <h1 class='editorial-title'>先看 CV，<br />再看最近更新。</h1>
        <p class='hero-lede'>公开履历、最近编辑的笔记，以及随笔等内容，都从这里进入。</p>
        <div class='hero-actions'>
          <a class='note-button' href='/cv'>查看 CV <span aria-hidden='true'>→</span></a>
          <a class='text-link' href='#recent-activity'>看最近活动 ↓</a>
        </div>
      </div>

      <a class='profile-card' href='/cv' aria-label='查看 Ami 的 CV'>
        <header class='profile-card-head'>
          <span class='mono-label'>个人资料</span>
          <span aria-hidden='true'>↗</span>
        </header>
        <div class='profile-identity'>
          <div>
            <p class='profile-kicker'>姓名</p>
            <h2 class='editorial-title'>Ami</h2>
          </div>
          <span class='profile-mark' aria-hidden='true'>A</span>
        </div>
        <p class='profile-summary'>
          关注 APS、组合优化与 Timefold Solver，持续把实践整理成可复查的公开内容。
        </p>
        <dl class='profile-facts'>
          <div><dt>公开方向</dt><dd>APS / 组合优化</dd></div>
          <div><dt>当前入口</dt><dd>CV + Activity</dd></div>
          <div><dt>代码与项目</dt><dd>GitHub ↗</dd></div>
        </dl>
        <footer>已确认资料 · 进入完整履历 <span aria-hidden='true'>→</span></footer>
      </a>
    </header>

    <section class='home-workspace animate' id='content' aria-label='最近活动'>
      <section class='activity-panel' id='recent-activity' aria-labelledby='recent-activity-title'>
        <header class='panel-head'>
          <div>
            <p class='mono-label'>Recent activity</p>
            <h2 id='recent-activity-title' class='editorial-title'>最近编辑或上传</h2>
          </div>
          <span class='panel-count'>{activity.length.toString().padStart(2, '0')} 项</span>
        </header>
        <p class='panel-intro'>按最近更新排序。点击进入内容。</p>
        <ol class='activity-list'>
          {
            recentActivity.map((item, index) => (
              <li>
                <a href={item.href}>
                  <span class:list={['activity-type', item.kind]} aria-hidden='true'>
                    {item.kind === 'note' ? 'N' : 'W'}
                  </span>
                  <span class='activity-copy'>
                    <strong>{item.title}</strong>
                    <small>
                      {item.kindLabel} · {item.latestAction}
                    </small>
                  </span>
                  <span class='activity-date'>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <time datetime={item.latestDate}>{formatDate(item.latestDate)}</time>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class='panel-more' href='/calendar'>进入活动日历 <span aria-hidden='true'>→</span></a>
      </section>

      <nav class='area-grid' aria-label='内容区域'>
        {
          entries.map((entry) => (
            <a href={entry.href}>
              <span class='area-code'>{entry.code}</span>
              <span class='area-copy'>
                <strong>{entry.title}</strong>
                <small>{entry.note}</small>
              </span>
              <span class='area-mark' aria-hidden='true'>
                {entry.mark}
              </span>
            </a>
          ))
        }
      </nav>
    </section>
  </main>
</PageLayout>

<style>
  .home-page {
    padding: clamp(1rem, 2.8vw, 2.5rem) 0 1rem;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(20rem, 0.82fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding: clamp(1.5rem, 3.5vw, 2.75rem) 0 clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid hsl(var(--foreground));
  }

  .hero-eyebrow {
    margin: 0 0 1.15rem;
    color: hsl(var(--primary));
  }

  .hero-copy h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.2rem, 3.4vw, 3.6rem);
    line-height: 1;
    text-wrap: balance;
  }

  .hero-lede {
    max-width: 37rem;
    margin: 1.1rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    align-items: center;
    margin-top: 1.15rem;
  }

  .text-link,
  .panel-more {
    color: hsl(var(--foreground));
    font-family: var(--mono-font);
    font-size: 0.68rem;
    text-decoration: underline;
    text-decoration-color: hsl(var(--border));
    text-underline-offset: 0.28rem;
  }

  .text-link:hover,
  .panel-more:hover {
    color: hsl(var(--primary));
    text-decoration-color: hsl(var(--primary));
  }

  .profile-card {
    display: block;
    min-width: 0;
    padding: clamp(0.9rem, 1.8vw, 1.2rem);
    border: 1px solid hsl(var(--foreground));
    color: hsl(var(--foreground));
    background:
      linear-gradient(135deg, hsl(var(--card) / 0.5), transparent 52%),
      hsl(var(--background) / 0.82);
    box-shadow: 6px 6px 0 hsl(var(--foreground) / 0.06);
  }

  .profile-card:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--primary));
    background: hsl(var(--muted) / 0.55);
  }

  .profile-card-head,
  .profile-card footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .profile-card-head {
    padding-bottom: 0.8rem;
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--primary));
  }

  .profile-card-head > span:last-child {
    font-family: var(--mono-font);
  }

  .profile-identity {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 0 0.85rem;
  }

  .profile-kicker {
    margin: 0 0 0.4rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.6rem;
  }

  .profile-identity h2 {
    margin: 0;
    font-size: clamp(2.5rem, 3.2vw, 3.2rem);
    line-height: 0.9;
  }

  .profile-mark {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid hsl(var(--foreground));
    color: hsl(var(--primary));
    font-family: var(--display-font);
    font-size: 2.3rem;
  }

  .profile-summary {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.74rem;
    line-height: 1.65;
  }

  .profile-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid hsl(var(--border));
  }

  .profile-facts div + div {
    padding-left: 0.75rem;
    border-left: 1px solid hsl(var(--border));
  }

  .profile-facts dt {
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
  }

  .profile-facts dd {
    margin: 0.35rem 0 0;
    color: hsl(var(--foreground));
    font-family: var(--mono-font);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  .profile-card footer {
    margin-top: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.6rem;
  }

  .profile-card footer span {
    color: hsl(var(--primary));
  }

  .home-workspace {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin-top: 1px;
    border: 1px solid hsl(var(--foreground));
    background: hsl(var(--foreground));
  }

  .activity-panel,
  .area-grid {
    min-width: 0;
    background: hsl(var(--background));
  }

  .activity-panel {
    padding: clamp(1rem, 2.2vw, 1.5rem);
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .panel-head .mono-label {
    margin: 0 0 0.55rem;
    color: hsl(var(--primary));
    font-size: 0.6rem;
  }

  .panel-head h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.4vw, 2.1rem);
    line-height: 1;
  }

  .panel-count {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.62rem;
  }

  .panel-intro {
    margin: 0.75rem 0 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .activity-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity-list li {
    border-top: 1px solid hsl(var(--border));
  }

  .activity-list a {
    display: grid;
    grid-template-columns: 1.55rem minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 3.35rem;
    color: hsl(var(--foreground));
  }

  .activity-list a:hover {
    padding-left: 0.25rem;
    color: hsl(var(--foreground));
  }

  .activity-type {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border: 1px solid hsl(var(--primary));
    color: hsl(var(--primary));
    font-family: var(--mono-font);
    font-size: 0.57rem;
  }

  .activity-type.essay {
    border-color: var(--accent-cool);
    color: var(--accent-cool);
  }

  .activity-copy {
    min-width: 0;
  }

  .activity-copy strong,
  .activity-copy small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .activity-copy strong {
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .activity-copy small {
    margin-top: 0.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
  }

  .activity-date {
    display: grid;
    gap: 0.24rem;
    justify-items: end;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.58rem;
  }

  .activity-date > span {
    color: hsl(var(--primary));
  }

  .panel-more {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: hsl(var(--foreground));
  }

  .area-grid > a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 3.85rem;
    padding: 0.8rem;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
  }

  .area-grid > a:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
  }

  .area-code,
  .area-mark {
    color: hsl(var(--primary));
    font-family: var(--mono-font);
    font-size: 0.61rem;
  }

  .area-copy {
    min-width: 0;
  }

  .area-copy strong,
  .area-copy small {
    display: block;
  }

  .area-copy strong {
    font-family: var(--display-font);
    font-size: 0.96rem;
    font-weight: 500;
  }

  .area-copy small {
    margin-top: 0.18rem;
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.58rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .profile-card {
      max-width: 37rem;
    }

    .area-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .home-page {
      padding-top: 0;
    }

    .home-hero {
      gap: 2rem;
      padding-top: 1.5rem;
    }

    .hero-copy h1 {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }

    .profile-facts {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .profile-facts div + div {
      padding-top: 0.7rem;
      padding-left: 0;
      border-top: 1px solid hsl(var(--border));
      border-left: 0;
    }

    .activity-list a {
      grid-template-columns: 1.35rem minmax(0, 1fr) auto;
      gap: 0.5rem;
      min-height: 4rem;
    }

    .activity-date > span {
      display: none;
    }

    .area-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .activity-date time {
      font-size: 0.53rem;
    }

    .area-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
