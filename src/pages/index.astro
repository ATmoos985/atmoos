---
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true
---

<PageLayout
  meta={{
    title: 'TSA · CV',
    description: 'TSA 的个人简历，关注 APS、组合优化与 Timefold 求解器。'
  }}
>
  <main id='main-content' class='cv-page'>
    <header class='cv-header'>
      <h1>TSA</h1>
      <p>APS 算法工程师</p>
      <ul class='cv-focus' aria-label='关注方向'>
        <li>APS</li>
        <li>组合优化</li>
        <li>Timefold Solver</li>
      </ul>
      <ul class='cv-contact' aria-label='联系方式'>
        <li>
          <a href='https://github.com/ATmoos985' rel='me'>
            <svg aria-hidden='true' width='14' height='14' viewBox='0 0 24 24' fill='currentColor'>
              <path
                d='M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.23 3.28.94.1-.73.39-1.23.71-1.51-2.5-.28-5.12-1.25-5.12-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.83 10.83 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z'
              ></path>
            </svg>
            <span>ATmoos985</span><span aria-hidden='true'>↗</span>
          </a>
        </li>
        <li>
          <a href='mailto:atmoos985@gmail.com'>
            <svg
              aria-hidden='true'
              width='14'
              height='14'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.6'
            >
              <rect x='3' y='5' width='18' height='14' rx='2'></rect>
              <path d='m3 6 9 7 9-7'></path>
            </svg>
            <span>atmoos985@gmail.com</span>
          </a>
        </li>
      </ul>
    </header>

    <div class='cv-details'>
      <section class='cv-section' aria-labelledby='about-title'>
        <h2 id='about-title'>简介</h2>
        <p>把学习与实践中的思考整理成公开笔记，记录对求解模型、约束评分与调优方法的理解。</p>
      </section>

      <section class='cv-section' aria-labelledby='experience-title'>
        <h2 id='experience-title'>工作 / 实习经历</h2>
        <p class='cv-placeholder'>待补充</p>
      </section>

      <section class='cv-section' aria-labelledby='work-title'>
        <h2 id='work-title'>代表项目</h2>
        <ul class='cv-work'>
          <li>
            <div class='project-heading'>
              <h3>
                <a href='https://github.com/ATmoos985/atmoos'
                  >Atmoos 个人网站 <span aria-hidden='true'>↗</span></a
                >
              </h3>
              <span class='project-meta'>Astro · 开源</span>
            </div>
            <p>用于整理和发布个人内容的开源网站。</p>
          </li>
        </ul>
      </section>

      <section class='cv-section' aria-labelledby='education-title'>
        <h2 id='education-title'>教育经历</h2>
        <p>2021–2025 · 大连海事大学</p>
        <p>计算机科学与技术专业</p>
      </section>

      <section class='cv-section' aria-labelledby='skills-title'>
        <h2 id='skills-title'>技术能力</h2>
        <p class='cv-placeholder'>待补充</p>
      </section>
    </div>
  </main>
</PageLayout>

<style>
  .cv-page {
    display: grid;
    flex: 1;
    grid-template-columns: clamp(12rem, 18vw, 18rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding: 1.75rem 0 2.25rem;
  }
  .cv-header {
    padding-right: 1.5rem;
    border-right: 1px solid hsl(var(--border) / 0.65);
  }
  .cv-details {
    display: grid;
    align-content: start;
    min-width: 0;
    gap: 1.5rem;
  }
  .cv-header h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }
  .cv-focus {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .cv-section p {
    margin: 0;
    max-width: 48rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .cv-section .cv-placeholder {
    font-size: 0.78rem;
  }
  .cv-contact {
    display: grid;
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    font-family: var(--mono-font);
    font-size: 0.75rem;
  }
  .cv-contact svg {
    flex: none;
  }
  .cv-contact a span:first-of-type {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .cv-contact a:hover span:first-of-type,
  .cv-work a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cv-section h2 {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .cv-work {
    display: grid;
    max-width: 48rem;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.25rem;
  }
  .cv-work h3 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .project-meta {
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }
  @media screen and (max-width: 640px) {
    .cv-page {
      flex: none;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .cv-header {
      padding: 0 0 1.25rem;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border) / 0.65);
    }
    .cv-focus {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 0.8rem;
    }
  }
  @media print {
    .cv-page {
      padding: 1rem 0;
    }
    .cv-section {
      break-inside: avoid;
    }
  }
</style>
