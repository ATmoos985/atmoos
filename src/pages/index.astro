---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { docsSeries } from '@/data/docs'

import PageLayout from '@/layouts/BaseLayout.astro'

const series = docsSeries[0]
const docs = (await getCollection('docs', ({ data }) => !data.draft)) as CollectionEntry<'docs'>[]
const seriesDocs = docs.filter((note) => note.data.series === series.id)
const articles = seriesDocs.filter((note) => !note.data.isIndex)
const overview = seriesDocs.find((note) => note.data.isIndex && !note.data.section)

const sections = series.sections.map((section) => {
  const notes = seriesDocs
    .filter((note) => note.data.section === section.id && !note.data.isIndex)
    .sort((a, b) => a.data.order - b.data.order)
  const index = seriesDocs.find((note) => note.data.section === section.id && note.data.isIndex)
  return { ...section, notes, index, first: notes[0] }
})

const recentNotes = [...articles]
  .sort(
    (a, b) =>
      (b.data.updatedDate?.valueOf() ?? b.data.publishDate?.valueOf() ?? 0) -
        (a.data.updatedDate?.valueOf() ?? a.data.publishDate?.valueOf() ?? 0) ||
      a.data.sectionOrder - b.data.sectionOrder ||
      a.data.order - b.data.order
  )
  .slice(0, 4)

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(date)
    : '持续整理'

const getSectionTitle = (note: CollectionEntry<'docs'>) =>
  series.sections.find((section) => section.id === note.data.section)?.shortTitle ?? '笔记'

const entries = [
  { code: '02', title: '专题', note: '沿知识路径浏览', href: '/topics', mark: '↗' },
  { code: '03', title: '项目', note: '公开项目与实践', href: '/projects', mark: '↗' },
  { code: '04', title: '近况', note: '此刻关注什么', href: '/now', mark: '→' },
  { code: '05', title: 'CV', note: '核对中的履历', href: '/cv', mark: '→' },
  { code: '06', title: '关于', note: '边界与整理方式', href: '/about', mark: '→' },
  { code: '⌕', title: '搜索', note: '定位概念与类名', href: '/search', mark: '↗' }
]
---

<PageLayout
  meta={{
    title: '首页',
    description: 'Ami 的个人工作台与公开技术笔记，聚焦组合优化、生产排程与 Timefold Solver。'
  }}
  highlightColor={series.color}
>
  <main class='home-dashboard'>
    <header class='home-intro animate' id='content-header'>
      <div class='intro-title'>
        <p class='mono-label'>Atmoos / Personal workbench</p>
        <h1 class='editorial-title'>当前正在整理什么。</h1>
      </div>

      <div class='intro-note'>
        <p>
          这里记录生产排程、组合优化与求解器工程。内容从真实笔记中筛选，保留推理路径，也标出仍在变化的部分。
        </p>
        <span><i aria-hidden='true'></i> PUBLIC NOTES · CONTINUOUSLY EDITED</span>
      </div>
    </header>

    <section class='workbench-grid animate' id='content' aria-label='站点主要入口'>
      <article class='focus-board'>
        <header class='board-head'>
          <div>
            <span class='mono-label'>Current notebook / 01</span>
            <span class='edition'>2026.07</span>
          </div>
          <strong>{String(articles.length).padStart(2, '0')} notes</strong>
        </header>

        <div class='focus-copy'>
          <p>{series.eyebrow}</p>
          <h2 class='editorial-title'>{series.shortTitle}</h2>
          <p>{series.summary}</p>
          <a class='note-button' href={overview ? `/docs/${overview.id}` : '/docs'}>
            打开笔记工作区 <span aria-hidden='true'>→</span>
          </a>
        </div>

        <ol class='route-map' aria-label='Timefold 笔记分组'>
          {
            sections.map((section) => (
              <li>
                <a
                  href={
                    section.index
                      ? `/docs/${section.index.id}`
                      : section.first
                        ? `/docs/${section.first.id}`
                        : '/docs'
                  }
                >
                  <span>{section.number}</span>
                  <strong>{section.shortTitle}</strong>
                  <small>{section.notes.length}</small>
                </a>
              </li>
            ))
          }
        </ol>
      </article>

      <section class='recent-board' aria-labelledby='recent-title'>
        <header class='board-head'>
          <div>
            <span class='mono-label'>Recently edited</span>
            <span class='edition'>READING QUEUE</span>
          </div>
          <a href='/docs'>全部 →</a>
        </header>

        <h2 id='recent-title' class='editorial-title'>最近整理</h2>
        <ol class='recent-list'>
          {
            recentNotes.map((note, index) => (
              <li>
                <a href={`/docs/${note.id}`}>
                  <span class='recent-index'>{String(index + 1).padStart(2, '0')}</span>
                  <span class='recent-copy'>
                    <strong>{note.data.title}</strong>
                    <small>{getSectionTitle(note)}</small>
                  </span>
                  <time datetime={(note.data.updatedDate ?? note.data.publishDate)?.toISOString()}>
                    {formatDate(note.data.updatedDate ?? note.data.publishDate)}
                  </time>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <nav class='entry-grid' aria-label='更多站点栏目'>
        {
          entries.map((entry) => (
            <a href={entry.href}>
              <span class='entry-code'>{entry.code}</span>
              <span class='entry-copy'>
                <strong>{entry.title}</strong>
                <small>{entry.note}</small>
              </span>
              <span class='entry-mark' aria-hidden='true'>
                {entry.mark}
              </span>
            </a>
          ))
        }
      </nav>
    </section>
  </main>
</PageLayout>

<style>
  .home-dashboard {
    min-height: calc(100dvh - 10rem);
    padding: clamp(1rem, 2.8vw, 2.5rem) 0 1rem;
  }

  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-bottom: clamp(1.5rem, 3vw, 2.4rem);
    border-bottom: 1px solid hsl(var(--foreground));
  }

  .intro-title .mono-label {
    margin: 0 0 0.8rem;
    color: hsl(var(--primary));
  }

  .intro-title h1 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.35rem, 4.5vw, 4.9rem);
    line-height: 0.99;
    text-wrap: balance;
  }

  .intro-note > p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .intro-note > span {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.59rem;
    letter-spacing: 0.09em;
  }

  .intro-note i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-cool);
    box-shadow: 0 0 0 4px hsl(var(--muted) / 0.85);
  }

  .workbench-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    gap: 1px;
    margin-top: 1px;
    border: 1px solid hsl(var(--foreground));
    background: hsl(var(--foreground));
  }

  .focus-board,
  .recent-board,
  .entry-grid {
    min-width: 0;
    background: hsl(var(--background));
  }

  .focus-board,
  .recent-board {
    min-height: 23.5rem;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .board-head > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .board-head .mono-label {
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
  }

  .edition,
  .board-head > strong,
  .board-head > a {
    font-family: var(--mono-font);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .edition {
    padding: 0.16rem 0.35rem;
    color: hsl(var(--primary));
    background: hsl(var(--muted));
  }

  .board-head > strong {
    font-weight: 500;
    text-transform: uppercase;
  }

  .focus-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 1.5rem;
    align-items: end;
    padding: 1.45rem 0 1.25rem;
  }

  .focus-copy > p:first-child {
    grid-column: 1 / -1;
    margin: 0 0 0.35rem;
    color: hsl(var(--primary));
    font-family: var(--mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .focus-copy h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 0.95;
  }

  .focus-copy > p:last-of-type {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .focus-copy .note-button {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: end;
    white-space: nowrap;
  }

  .route-map {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--foreground));
    border-left: 1px solid hsl(var(--border));
    list-style: none;
  }

  .route-map li {
    min-width: 0;
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
  }

  .route-map a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.55rem;
    align-items: center;
    min-height: 3.15rem;
    padding: 0.6rem 0.65rem;
    color: hsl(var(--foreground));
    background: hsl(var(--card) / 0.25);
  }

  .route-map a:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.75);
  }

  .route-map span,
  .route-map small {
    font-family: var(--mono-font);
    font-size: 0.57rem;
  }

  .route-map span {
    color: hsl(var(--primary));
  }

  .route-map small {
    color: hsl(var(--muted-foreground));
  }

  .route-map strong {
    overflow: hidden;
    font-size: 0.74rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-board h2 {
    margin: 1.3rem 0 0.6rem;
    font-size: 2rem;
    line-height: 1;
  }

  .recent-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-list li + li {
    border-top: 1px solid hsl(var(--border));
  }

  .recent-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 3.5rem;
    color: hsl(var(--foreground));
  }

  .recent-list a:hover {
    padding-left: 0.25rem;
    color: hsl(var(--foreground));
  }

  .recent-index,
  .recent-list time {
    font-family: var(--mono-font);
    font-size: 0.56rem;
  }

  .recent-index {
    color: hsl(var(--primary));
  }

  .recent-list time {
    color: hsl(var(--muted-foreground));
  }

  .recent-copy {
    min-width: 0;
  }

  .recent-copy strong,
  .recent-copy small {
    display: block;
  }

  .recent-copy strong {
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-copy small {
    margin-top: 0.16rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.58rem;
  }

  .entry-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: hsl(var(--foreground));
  }

  .entry-grid > a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 5.4rem;
    padding: 0.8rem;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
  }

  .entry-grid > a:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
  }

  .entry-code,
  .entry-mark {
    color: hsl(var(--primary));
    font-family: var(--mono-font);
    font-size: 0.62rem;
  }

  .entry-copy {
    min-width: 0;
  }

  .entry-copy strong,
  .entry-copy small {
    display: block;
  }

  .entry-copy strong {
    font-family: var(--display-font);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .entry-copy small {
    margin-top: 0.18rem;
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.58rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .entry-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .home-intro,
    .workbench-grid {
      grid-template-columns: 1fr;
    }

    .home-intro {
      gap: 1.25rem;
    }

    .focus-board,
    .recent-board {
      min-height: 0;
    }

    .entry-grid {
      grid-column: auto;
    }
  }

  @media (max-width: 620px) {
    .home-dashboard {
      padding-top: 0.5rem;
    }

    .intro-title h1 {
      font-size: clamp(2.35rem, 11vw, 3.7rem);
    }

    .focus-copy {
      display: block;
    }

    .focus-copy .note-button {
      margin-top: 1rem;
    }

    .route-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .entry-grid > a {
      min-height: 5rem;
    }
  }
</style>
