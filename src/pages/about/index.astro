---
import BaseLayout from '@/layouts/BaseLayout.astro'

const topics = ['APS', '组合优化', 'Timefold 求解器']

const reviewSteps = [
  {
    number: '01',
    title: '来源筛选',
    description: '从 Obsidian 原始笔记中选择适合公开的主题。'
  },
  {
    number: '02',
    title: '公开审查',
    description: '检查公开范围，工作项目笔记不进入网站。'
  },
  {
    number: '03',
    title: '阅读整理',
    description: '为公开阅读重组标题、层级与站内导航。'
  }
]
---

<BaseLayout
  meta={{
    title: '关于',
    description: 'Ami 的公开知识库，从 Obsidian 笔记经公开范围审查后同步。'
  }}
>
  <main class='about-page' aria-labelledby='about-title'>
    <header class='document-head'>
      <div class='document-code' aria-hidden='true'>
        <span>A—01</span>
        <span>ABOUT / PUBLIC NOTES</span>
      </div>

      <div class='document-title'>
        <p class='eyebrow'>Ami · 公开知识档案</p>
        <h1 id='about-title'>把笔记带出 Obsidian，<br />但不带走它的边界。</h1>
        <p class='lede'>
          这里是 Ami 的个人知识库。内容源自我的 Obsidian 笔记，在同步到网站前会先经过公开范围审查。
        </p>
      </div>

      <dl class='document-meta'>
        <div>
          <dt>Source</dt>
          <dd>Obsidian</dd>
        </div>
        <div>
          <dt>Edition</dt>
          <dd>Public</dd>
        </div>
        <div>
          <dt>Author</dt>
          <dd>Ami</dd>
        </div>
      </dl>
    </header>

    <div class='topic-ledger' aria-label='当前公开主题'>
      <p>当前公开内容</p>
      <ol>
        {
          topics.map((topic, index) => (
            <li>
              <span aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span>
              {topic}
            </li>
          ))
        }
      </ol>
    </div>

    <div class='page-grid'>
      <aside class='section-index' aria-label='本页索引'>
        <p>INDEX</p>
        <nav>
          <a href='#archive'><span>01</span>这里是什么</a>
          <a href='#first-edition'><span>02</span>首批内容</a>
          <a href='#boundary'><span>03</span>公开边界</a>
          <a href='#workflow'><span>04</span>整理方式</a>
        </nav>
      </aside>

      <article class='manuscript'>
        <section id='archive' class='numbered-section' aria-labelledby='archive-title'>
          <div class='section-number' aria-hidden='true'>01</div>
          <div class='section-copy'>
            <p class='section-kicker'>PUBLIC ARCHIVE</p>
            <h2 id='archive-title'>这里是什么</h2>
            <p>
              这是一份持续编辑的个人知识档案，用来放置经过整理、可以公开阅读的笔记。
              网站是公开版，Obsidian 仍是原始内容的整理地。
            </p>
          </div>
        </section>

        <section id='first-edition' class='numbered-section' aria-labelledby='first-title'>
          <div class='section-number' aria-hidden='true'>02</div>
          <div class='section-copy'>
            <p class='section-kicker'>FIRST EDITION</p>
            <h2 id='first-title'>首批内容</h2>
            <p>
              首批同步的是 <strong>Timefold 求解器教程</strong>。目前公开内容集中在 APS、组合优化与
              Timefold 求解器；后续内容会在完成审查和整理后再逐步进入。
            </p>
            <a class='text-link' href='/docs'>
              <span>进入笔记库</span>
              <span aria-hidden='true'>→</span>
            </a>
          </div>
        </section>

        <section id='boundary' class='numbered-section' aria-labelledby='boundary-title'>
          <div class='section-number' aria-hidden='true'>03</div>
          <div class='section-copy'>
            <p class='section-kicker'>PUBLISHING BOUNDARY</p>
            <h2 id='boundary-title'>公开边界</h2>
            <dl class='boundary-list'>
              <div>
                <dt>公开</dt>
                <dd>通过范围审查、能够独立阅读的知识笔记。</dd>
              </div>
              <div>
                <dt>不公开</dt>
                <dd>工作项目笔记，以及依赖工作上下文的材料。</dd>
              </div>
              <div>
                <dt>未同步</dt>
                <dd>尚未完成公开审查的内容，继续留在 Obsidian 中。</dd>
              </div>
            </dl>
          </div>
        </section>

        <section id='workflow' class='numbered-section' aria-labelledby='workflow-title'>
          <div class='section-number' aria-hidden='true'>04</div>
          <div class='section-copy'>
            <p class='section-kicker'>EDITORIAL WORKFLOW</p>
            <h2 id='workflow-title'>整理方式</h2>
            <ol class='review-steps'>
              {
                reviewSteps.map((step) => (
                  <li>
                    <span>{step.number}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
      </article>
    </div>

    <footer class='document-foot'>
      <p>如果你想查看代码与公开仓库，可以在 GitHub 找到 Ami。</p>
      <a href='https://github.com/ATmoos985' target='_blank' rel='noreferrer'>
        github.com/ATmoos985 <span aria-hidden='true'>↗</span>
      </a>
    </footer>
  </main>
</BaseLayout>

<style>
  .about-page {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 8vw, 6rem);
  }

  .document-head {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 8.5rem;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-block: 1px solid hsl(var(--foreground) / 0.72);
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .document-code,
  .document-meta,
  .eyebrow,
  .section-kicker,
  .section-index,
  .topic-ledger > p {
    font-family: var(--mono-font);
  }

  .document-code {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  h1,
  h2 {
    font-family: var(--display-font);
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 3.8vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 46rem;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }

  .document-meta {
    align-self: end;
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .document-meta div {
    border-top: 1px solid hsl(var(--border));
    padding-block: 0.6rem;
  }

  .document-meta dt {
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .document-meta dd {
    margin: 0.18rem 0 0;
  }

  .topic-ledger {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 1rem;
  }

  .topic-ledger > p {
    margin: 0;
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
  }

  .topic-ledger ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-ledger li {
    display: flex;
    gap: 0.55rem;
    font-size: 0.82rem;
  }

  .topic-ledger li span {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.65rem;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }

  .section-index {
    position: sticky;
    top: 2rem;
    align-self: start;
    font-size: 0.7rem;
  }

  .section-index > p {
    margin: 0 0 1rem;
    letter-spacing: 0.16em;
    color: hsl(var(--muted-foreground));
  }

  .section-index nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid hsl(var(--border));
  }

  .section-index a {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.35rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 0.7rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    text-decoration: none;
  }

  .section-index a:hover {
    color: hsl(var(--foreground));
  }

  .manuscript {
    border-top: 1px solid hsl(var(--foreground) / 0.72);
  }

  .numbered-section {
    display: grid;
    grid-template-columns: clamp(3.25rem, 7vw, 6.5rem) minmax(0, 1fr);
    border-bottom: 1px solid hsl(var(--border));
    scroll-margin-top: 6.5rem;
  }

  .section-number {
    padding-top: clamp(1.75rem, 4vw, 3rem);
    border-right: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .section-copy {
    padding: clamp(1.75rem, 4vw, 3rem) 0 clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  .section-kicker {
    margin: 0 0 0.8rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    letter-spacing: 0.16em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .section-copy > p:not(.section-kicker) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.95;
    color: hsl(var(--muted-foreground));
  }

  .section-copy strong {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 1.75rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
    color: hsl(var(--foreground));
    font-size: 0.86rem;
    text-decoration: none;
  }

  .boundary-list {
    margin: 2rem 0 0;
    border-top: 1px solid hsl(var(--border));
  }

  .boundary-list div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    border-bottom: 1px solid hsl(var(--border));
  }

  .boundary-list dt,
  .boundary-list dd {
    padding-block: 0.9rem;
  }

  .boundary-list dt {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .boundary-list dd {
    margin: 0;
    border-left: 1px solid hsl(var(--border));
    padding-left: 1.25rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .review-steps {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
    list-style: none;
  }

  .review-steps li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 1.1rem;
  }

  .review-steps > li > span {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.68rem;
  }

  .review-steps h3,
  .review-steps p {
    margin: 0;
  }

  .review-steps h3 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .review-steps p {
    margin-top: 0.35rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .document-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    border-block: 1px solid hsl(var(--foreground) / 0.72);
    padding-block: 1.4rem;
  }

  .document-foot p {
    max-width: 32rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .document-foot a {
    flex: none;
    color: hsl(var(--foreground));
    font-family: var(--mono-font);
    font-size: 0.75rem;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .document-head {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .document-code {
      flex-direction: row;
      justify-content: space-between;
    }

    .document-meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid hsl(var(--border));
    }

    .document-meta div {
      border-top: 0;
      border-right: 1px solid hsl(var(--border));
      padding: 0.7rem;
    }

    .document-meta div:first-child {
      padding-left: 0;
    }

    .document-meta div:last-child {
      border-right: 0;
    }

    .topic-ledger,
    .page-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .section-index {
      position: static;
    }

    .section-index nav {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border-left: 1px solid hsl(var(--border));
    }

    .section-index a {
      border-right: 1px solid hsl(var(--border));
      padding-inline: 0.65rem;
    }

    .document-foot {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 460px) {
    h1 br {
      display: none;
    }

    .document-meta {
      grid-template-columns: 1fr;
    }

    .document-meta div,
    .document-meta div:first-child {
      display: flex;
      justify-content: space-between;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border));
      padding: 0.55rem 0;
    }

    .document-meta div:last-child {
      border-bottom: 0;
    }

    .document-meta dd {
      margin: 0;
    }

    .section-index nav {
      grid-template-columns: 1fr;
    }

    .numbered-section {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .boundary-list div {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }
  }
</style>
