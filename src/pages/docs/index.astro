---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { docsSeries } from '@/data/docs'

import PageLayout from '@/layouts/BaseLayout.astro'
import DocsContents from '@/components/docs/DocsContents.astro'

const docs = (await getCollection('docs', ({ data }) => !data.draft)) as CollectionEntry<'docs'>[]

const seriesCards = docsSeries.map((series) => {
  const notes = docs.filter((note) => note.data.series === series.id)
  const articles = notes.filter((note) => !note.data.isIndex)
  const overview = notes.find((note) => note.data.isIndex && !note.data.section)
  const sections = series.sections.map((section) => ({
    ...section,
    count: articles.filter((note) => note.data.section === section.id).length,
    index: notes.find((note) => note.data.isIndex && note.data.section === section.id)
  }))
  return { ...series, notes, articles, overview, sections }
})

const totalArticles = seriesCards.reduce((sum, series) => sum + series.articles.length, 0)
---

<PageLayout
  meta={{
    title: '笔记',
    description: '按学习路径组织的公开技术笔记，当前首批为 Timefold Solver 求解器教程。'
  }}
  highlightColor='#d65a34'
>
  <main class='docs-index'>
    <header class='docs-hero animate' id='content-header'>
      <div>
        <p class='mono-label'>Public knowledge base / 001</p>
        <h1 class='editorial-title'>笔记不是文章堆。<br />先给它一条阅读路径。</h1>
      </div>
      <div class='docs-intro'>
        <p>
          这里收录从 Obsidian 中筛选出的可复用技术笔记。内容保留“持续整理”的状态，
          同时把内部工作项目和公开教程分开。
        </p>
        <dl>
          <div><dt>专题</dt><dd>{seriesCards.length}</dd></div>
          <div>
            <dt>章节</dt><dd>
              {docsSeries.reduce((sum, series) => sum + series.sections.length, 0)}
            </dd>
          </div>
          <div><dt>正文</dt><dd>{totalArticles}</dd></div>
        </dl>
      </div>
    </header>

    <div class='docs-rule animate' id='content'>
      <span>INDEX</span>
      <span>OBSIDIAN SOURCE / PUBLIC REVIEWED</span>
    </div>

    {
      seriesCards.map((series) => (
        <section class='series-section' style={`--series-color:${series.color}`}>
          <div class='series-summary'>
            <div class='series-number'>{series.number}</div>
            <p class='mono-label'>{series.eyebrow}</p>
            <h2 class='editorial-title'>{series.title}</h2>
            <p>{series.description}</p>
            <div class='series-actions'>
              <a
                class='note-button'
                href={series.overview ? `/docs/${series.overview.id}` : '/docs'}
              >
                打开学习索引 →
              </a>
              <a class='text-link' href='/docs/rss.xml'>
                订阅 RSS
              </a>
            </div>
          </div>

          <ol class='section-ledger'>
            {series.sections.map((section) => (
              <li>
                <a href={section.index ? `/docs/${section.index.id}` : '/docs'}>
                  <span class='ledger-number'>{section.number}</span>
                  <span class='ledger-copy'>
                    <strong>{section.title}</strong>
                    <small>{section.summary}</small>
                  </span>
                  <span class='ledger-count'>{section.count.toString().padStart(2, '0')}</span>
                  <span class='ledger-arrow' aria-hidden='true'>
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class='full-index'>
      <div class='full-index-heading'>
        <div>
          <p class='mono-label'>Complete ledger</p>
          <h2 class='editorial-title'>完整目录</h2>
        </div>
        <p>章节索引和正文都列在这里，适合查找一篇具体笔记。</p>
      </div>
      <DocsContents title={false} />
    </section>
  </main>
</PageLayout>

<style>
  .docs-index {
    padding: 2rem 0 1rem;
  }

  .docs-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding: 1.75rem 0 2.75rem;
  }

  .docs-hero .mono-label {
    margin: 0 0 1.2rem;
    color: hsl(var(--primary));
  }

  .docs-hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.2rem, 3.6vw, 3.6rem);
    line-height: 1;
  }

  .docs-intro > p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.9;
  }

  .docs-intro dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }

  .docs-intro dl div + div {
    padding-left: 1rem;
    border-left: 1px solid hsl(var(--border));
  }

  .docs-intro dt {
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }

  .docs-intro dd {
    margin: 0.2rem 0 0;
    font-family: var(--mono-font);
    font-size: 1rem;
  }

  .docs-rule {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0;
    border-top: 1px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--foreground));
    font-family: var(--mono-font);
    font-size: 0.64rem;
    letter-spacing: 0.09em;
  }

  .docs-rule span:last-child {
    color: hsl(var(--muted-foreground));
  }

  .series-section {
    display: grid;
    grid-template-columns: minmax(19rem, 0.72fr) minmax(0, 1.28fr);
    gap: 5rem;
    padding: 4rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }

  .series-summary {
    position: relative;
    padding-left: 4rem;
  }

  .series-number {
    position: absolute;
    top: -0.7rem;
    left: 0;
    color: var(--series-color);
    font-family: var(--display-font);
    font-size: 3.4rem;
    line-height: 1;
  }

  .series-summary .mono-label {
    margin: 0 0 0.8rem;
    color: hsl(var(--muted-foreground));
  }

  .series-summary h2 {
    margin: 0;
    font-size: clamp(2.1rem, 3.2vw, 3.5rem);
    line-height: 0.98;
  }

  .series-summary > p:not(.mono-label) {
    margin: 1.5rem 0 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.85;
  }

  .series-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 1.8rem;
  }

  .text-link {
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: hsl(var(--border));
    text-underline-offset: 0.3rem;
  }

  .section-ledger {
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--foreground));
    list-style: none;
  }

  .section-ledger li {
    border-bottom: 1px solid hsl(var(--border));
  }

  .section-ledger a {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 0;
    color: hsl(var(--foreground));
  }

  .section-ledger a:hover {
    padding-left: 0.4rem;
    color: hsl(var(--foreground));
  }

  .ledger-number,
  .ledger-count {
    font-family: var(--mono-font);
    font-size: 0.67rem;
  }

  .ledger-number {
    color: var(--series-color);
  }

  .ledger-count {
    color: hsl(var(--muted-foreground));
  }

  .ledger-copy strong,
  .ledger-copy small {
    display: block;
  }

  .ledger-copy strong {
    font-family: var(--display-font);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .ledger-copy small {
    margin-top: 0.3rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .ledger-arrow {
    color: hsl(var(--primary));
  }

  .full-index {
    padding: 4rem 0 2rem;
  }

  .full-index-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .full-index-heading h2 {
    margin: 0.35rem 0 0;
    font-size: 2.5rem;
  }

  .full-index-heading > p {
    max-width: 25rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .docs-hero,
    .series-section {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .series-section {
      padding: 5rem 0;
    }
  }

  @media (max-width: 620px) {
    .docs-hero h1 {
      font-size: clamp(2.35rem, 10vw, 3.2rem);
    }

    .series-summary {
      padding-left: 0;
    }

    .series-number {
      position: static;
      margin-bottom: 1rem;
    }

    .full-index-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
