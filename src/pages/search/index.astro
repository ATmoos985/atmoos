---
import { PFSearch } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'
---

<PageLayout meta={{ description: '搜索 Atmoos 公开笔记', title: '搜索' }}>
  <main class='search-page'>
    <a class='mono-label back-link' href='/docs'>← 返回笔记</a>
    <header id='content-header' class='animate'>
      <p class='mono-label'>Full-text index</p>
      <h1 class='editorial-title'>搜索公开笔记</h1>
      <p>输入概念、类名或业务问题，检索已经公开的 Timefold 教程。</p>
    </header>

    <div id='content' class='search-box animate'>
      {integ.pagefind ? <PFSearch /> : <p>站内搜索暂未启用。</p>}
    </div>
  </main>
</PageLayout>

<style>
  .search-page {
    max-width: 52rem;
    min-height: 62vh;
    margin: 0 auto;
    padding: 2rem 0 5rem;
  }

  .back-link {
    color: hsl(var(--muted-foreground));
  }

  header {
    margin-top: 5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid hsl(var(--foreground));
  }

  header > .mono-label {
    margin: 0 0 0.8rem;
    color: hsl(var(--primary));
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    line-height: 1;
  }

  header > p:last-child {
    margin: 1.25rem 0 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }

  .search-box {
    margin-top: 2rem;
  }
</style>
