---
import { getCourses, getTutorials, tutorialUrl } from '@/data/tutorials'

import ContentLayout from '@/layouts/ContentLayout.astro'
import ArticleReader from '@/components/ArticleReader.astro'
import TutorialNavigation from '@/components/TutorialNavigation.astro'

export const prerender = false
const notes = await getTutorials()
const courses = getCourses(notes)
const requestedCourse = Astro.url.searchParams.get('course') ?? 'data-structures'
const course = courses.find((item) => item.id === requestedCourse) ?? courses[0]
const activeTag = Astro.url.searchParams.get('tag')?.trim().toLowerCase() ?? ''
const matches = activeTag
  ? notes.filter((note) => note.data.tags.includes(activeTag))
  : course.notes
const first = !activeTag ? course.notes[0] : undefined
const second = course.notes[1]
---

{
  first ? (
    <ArticleReader
      post={first}
      next={second ? { title: second.data.title, url: tutorialUrl(second) } : undefined}
    />
  ) : (
    <ContentLayout
      meta={{
        title: activeTag ? `教程 · ${activeTag}` : course.title,
        description: 'Ami 的教程与学习笔记。'
      }}
      sectionUrl='/tutorials'
      sectionLabel='教程'
      tutorial
    >
      <TutorialNavigation slot='navigation' {notes} activeCourse={course.id} />
      <Fragment slot='header'>
        <h1 class='editorial-title'>{activeTag ? `标签：${activeTag}` : course.title}</h1>
      </Fragment>
      {activeTag && matches.length ? (
        <ul>
          {matches.map((note) => (
            <li>
              <a href={tutorialUrl(note)}>{note.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          {activeTag
            ? '这个标签下暂时没有笔记。'
            : '这一栏的笔记正在整理中。你可以先阅读数据结构。'}
        </p>
      )}
      <p>
        <a href='/tutorials'>阅读数据结构 →</a>
      </p>
    </ContentLayout>
  )
}
