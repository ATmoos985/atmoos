---
import BaseLayout from '@/layouts/BaseLayout.astro'

const verifiedFocus = ['APS', '组合优化', 'Timefold 求解器']

const pendingSections = [
  {
    number: '02',
    eyebrow: 'EXPERIENCE',
    title: '经历',
    fields: [
      ['时间', '待确认'],
      ['机构与角色', '待确认'],
      ['职责与成果', '待核对原始资料后补充']
    ]
  },
  {
    number: '03',
    eyebrow: 'PROJECTS',
    title: '项目',
    fields: [
      ['项目名称与链接', '待确认'],
      ['负责范围', '待确认'],
      ['可验证成果', '待核对原始资料后补充']
    ]
  },
  {
    number: '04',
    eyebrow: 'EDUCATION',
    title: '教育',
    fields: [
      ['学校与专业', '待确认'],
      ['学习阶段', '待确认'],
      ['可公开信息', '待本人确认后补充']
    ]
  }
]
---

<BaseLayout
  meta={{
    title: 'CV',
    description: 'Ami 的公开履历页。内容正在核对与整理中。'
  }}
>
  <main class='cv-page' aria-labelledby='cv-title'>
    <header class='cv-head'>
      <div class='folio' aria-hidden='true'>CV—00</div>
      <div class='title-block'>
        <p class='eyebrow'>CURRICULUM VITAE / VERIFIED EDITION</p>
        <h1 id='cv-title'>Ami</h1>
        <p class='descriptor'>履历档案</p>
      </div>
      <a class='github-link' href='https://github.com/ATmoos985' target='_blank' rel='noreferrer'>
        <span>GITHUB</span>
        <strong>ATmoos985</strong>
        <span aria-hidden='true'>↗</span>
      </a>
    </header>

    <aside class='status-note' aria-label='履历页状态'>
      <div class='status-mark' aria-hidden='true'>DRAFT</div>
      <div>
        <p class='status-title'>内容整理中</p>
        <p>
          此页目前只展示已确认信息。经历、项目与教育背景会在原始资料核对完成后逐项补入，不使用推测内容补全。
        </p>
      </div>
    </aside>

    <section class='cv-section profile-section' aria-labelledby='profile-title'>
      <header class='section-label'>
        <span>01</span>
        <div>
          <p>PROFILE</p>
          <h2 id='profile-title'>已确认信息</h2>
        </div>
      </header>

      <div class='profile-grid'>
        <dl class='identity-sheet'>
          <div>
            <dt>公开名称</dt>
            <dd>Ami</dd>
          </div>
          <div>
            <dt>公开内容方向</dt>
            <dd>APS / 组合优化 / Timefold 求解器</dd>
          </div>
          <div>
            <dt>公开链接</dt>
            <dd>
              <a href='https://github.com/ATmoos985' target='_blank' rel='noreferrer'>
                github.com/ATmoos985
              </a>
            </dd>
          </div>
        </dl>

        <div class='focus-index' aria-label='已确认的公开内容方向'>
          <p>CURRENT PUBLIC FOCUS</p>
          <ol>
            {
              verifiedFocus.map((item, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{item}</strong>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    {
      pendingSections.map((section) => (
        <section class='cv-section pending-section' aria-labelledby={`section-${section.number}`}>
          <header class='section-label'>
            <span>{section.number}</span>
            <div>
              <p>{section.eyebrow}</p>
              <h2 id={`section-${section.number}`}>{section.title}</h2>
            </div>
          </header>

          <article class='pending-record' aria-label={`${section.title}内容待整理`}>
            <div class='record-status'>
              <span>PENDING REVIEW</span>
              <strong>待核对后公开</strong>
            </div>
            <dl>
              {section.fields.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </article>
        </section>
      ))
    }

    <footer class='cv-foot'>
      <span aria-hidden='true'>END OF VERIFIED RECORD</span>
      <p>未经核对的履历信息不在此页展示。</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .cv-page {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 8vw, 6rem);
  }

  .cv-head {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) 12rem;
    align-items: end;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    border-block: 1px solid hsl(var(--foreground) / 0.76);
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .folio,
  .eyebrow,
  .github-link,
  .status-mark,
  .section-label > span,
  .section-label p,
  .focus-index > p,
  .record-status,
  .cv-foot > span {
    font-family: var(--mono-font);
  }

  .folio {
    align-self: start;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  h1,
  h2 {
    font-family: var(--display-font);
  }

  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 12vw, 9rem);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.07em;
  }

  .descriptor {
    margin: 1.25rem 0 0;
    color: hsl(var(--muted-foreground));
    font-family: var(--display-font);
    font-size: 1.05rem;
    letter-spacing: 0.28em;
  }

  .github-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.75rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.7rem;
    color: hsl(var(--foreground));
    font-size: 0.66rem;
    text-decoration: none;
  }

  .github-link > span:first-child {
    grid-column: 1 / -1;
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.14em;
  }

  .github-link strong {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .status-note {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    border-bottom: 1px solid hsl(var(--foreground) / 0.76);
    padding-block: clamp(1.25rem, 3vw, 2rem);
    background: hsl(var(--muted) / 0.34);
  }

  .status-mark {
    padding-left: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .status-note > div:last-child {
    display: grid;
    grid-template-columns: minmax(8rem, 0.4fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-right: clamp(0rem, 3vw, 2rem);
  }

  .status-title {
    margin: 0;
    font-family: var(--display-font);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 600;
  }

  .status-note > div > p:last-child {
    max-width: 40rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .cv-section {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid hsl(var(--foreground) / 0.76);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .section-label {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-self: start;
    gap: 1rem;
  }

  .section-label > span {
    padding-top: 0.25rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }

  .section-label p {
    margin: 0 0 0.5rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 500;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(13rem, 0.75fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .identity-sheet {
    margin: 0;
    border-top: 1px solid hsl(var(--border));
  }

  .identity-sheet div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 1fr);
    border-bottom: 1px solid hsl(var(--border));
  }

  .identity-sheet dt,
  .identity-sheet dd {
    padding-block: 0.95rem;
  }

  .identity-sheet dt {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
  }

  .identity-sheet dd {
    margin: 0;
    border-left: 1px solid hsl(var(--border));
    padding-left: 1.25rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .identity-sheet a {
    color: hsl(var(--foreground));
    text-decoration-color: hsl(var(--muted-foreground));
    text-underline-offset: 0.25rem;
  }

  .focus-index {
    border-left: 1px solid hsl(var(--border));
    padding-left: clamp(1.25rem, 3vw, 2rem);
  }

  .focus-index > p {
    margin: 0 0 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.64rem;
    letter-spacing: 0.14em;
  }

  .focus-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-index li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.7rem;
    border-top: 1px solid hsl(var(--border));
    padding-block: 0.8rem;
  }

  .focus-index li:last-child {
    border-bottom: 1px solid hsl(var(--border));
  }

  .focus-index li span {
    color: hsl(var(--muted-foreground));
    font-family: var(--mono-font);
    font-size: 0.63rem;
  }

  .focus-index li strong {
    font-size: 0.86rem;
    font-weight: 500;
  }

  .pending-record {
    border: 1px solid hsl(var(--border));
  }

  .record-status {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid hsl(var(--border));
    padding: 0.8rem 1rem;
    background: hsl(var(--muted) / 0.34);
    font-size: 0.63rem;
    letter-spacing: 0.1em;
  }

  .record-status strong {
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .pending-record dl {
    margin: 0;
  }

  .pending-record dl div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.36fr) minmax(0, 1fr);
    border-bottom: 1px solid hsl(var(--border));
  }

  .pending-record dl div:last-child {
    border-bottom: 0;
  }

  .pending-record dt,
  .pending-record dd {
    padding: 0.95rem 1rem;
  }

  .pending-record dt {
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
  }

  .pending-record dd {
    margin: 0;
    border-left: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
  }

  .cv-foot {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.25rem;
  }

  .cv-foot > span {
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }

  .cv-foot p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
  }

  @media (max-width: 780px) {
    .cv-head {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .github-link {
      grid-column: 2;
      max-width: 15rem;
    }

    .status-note {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .status-mark {
      padding-left: 0;
      writing-mode: vertical-rl;
    }

    .status-note > div:last-child {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .cv-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .profile-grid {
      grid-template-columns: 1fr;
    }

    .focus-index {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 480px) {
    .cv-head {
      grid-template-columns: 1fr;
    }

    .folio,
    .github-link {
      grid-column: 1;
    }

    .github-link {
      max-width: none;
    }

    .status-note {
      grid-template-columns: 1fr;
    }

    .status-mark {
      writing-mode: initial;
    }

    .identity-sheet div,
    .pending-record dl div {
      grid-template-columns: 1fr;
    }

    .identity-sheet dt,
    .pending-record dt {
      padding-bottom: 0.2rem;
    }

    .identity-sheet dd,
    .pending-record dd {
      border-left: 0;
      padding-top: 0.2rem;
    }

    .cv-foot {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media print {
    .cv-page {
      padding-block: 1rem;
    }

    .cv-section {
      break-inside: avoid;
      padding-block: 2rem;
    }

    .github-link {
      color: inherit;
    }
  }
</style>
