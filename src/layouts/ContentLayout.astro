---
import type { SiteMeta } from 'astro-pure/types'
import PageLayout from '@/layouts/BaseLayout.astro'
import ReaderSidebar from '@/components/ReaderSidebar.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  sectionUrl: string
  sectionLabel: string
  language?: string
  tutorial?: boolean
  hasContents?: boolean
}

const {
  meta,
  sectionUrl,
  sectionLabel,
  language = 'zh-CN',
  tutorial = false,
  hasContents = false
} = Astro.props
---

<PageLayout {meta}>
  <div
    class:list={[
      'reader-layout',
      { 'tutorial-workspace': tutorial, 'has-contents': tutorial && hasContents }
    ]}
  >
    {
      tutorial && (
        <ReaderSidebar side='left' label='教程导航'>
          <slot name='navigation' />
        </ReaderSidebar>
      )
    }
    {
      tutorial && hasContents && (
        <ReaderSidebar side='right' label='文章目录'>
          <slot name='contents' />
        </ReaderSidebar>
      )
    }
    <main id='main-content' class='reading-page'>
      <a class='reading-back text-link' href={sectionUrl}>← {sectionLabel}</a>
      <article lang={language}>
        <header class='article-header'>
          <slot name='header' />
        </header>
        {!tutorial && <slot name='contents' />}
        <div class:list={['article-prose prose text-base max-w-none', integ.typography.class]}>
          <slot />
        </div>
      </article>
      <slot name='adjacent' />
      <footer class='reading-footer'>
        <a class='text-link' href={sectionUrl}>← 返回{sectionLabel}</a>
        <a class='text-link' href='#main-content'>回到顶部 ↑</a>
      </footer>
      <p class='reader-status' role='status' aria-live='polite' data-reader-status></p>
      <dialog class='image-dialog' aria-label='图片预览'>
        <button type='button' class='image-close'>关闭 ×</button>
        <div class='image-preview'></div>
      </dialog>
    </main>
  </div>
</PageLayout>

<script>
  import '../scripts/reading'
  import '../scripts/diagrams'
  import '../scripts/reader-sidebars'
</script>

<style>
  .reader-layout {
    min-width: 0;
  }
  .tutorial-workspace {
    --left-rail-width: clamp(22rem, 26vw, 27rem);
    --right-rail-width: clamp(12rem, 15vw, 15rem);
    display: grid;
    grid-template-columns: var(--left-rail-width) minmax(0, 1fr);
    grid-template-areas: 'navigation main';
    gap: clamp(1.25rem, 2vw, 2.5rem);
    align-items: start;
  }
  .tutorial-workspace.has-contents {
    grid-template-columns: var(--left-rail-width) minmax(0, 1fr) var(--right-rail-width);
    grid-template-areas: 'navigation main contents';
  }
  :global(.tutorial-workspace:has(> [data-reader-sidebar='left']:not([open]))) {
    --left-rail-width: 2.25rem;
  }
  :global(.tutorial-workspace:has(> [data-reader-sidebar='right']:not([open]))) {
    --right-rail-width: 2.25rem;
  }
  .tutorial-workspace .reading-page {
    grid-area: main;
    max-width: 64rem;
    justify-self: center;
    padding-top: 2rem;
  }
  .tutorial-workspace .article-header {
    padding-top: 1rem;
  }
  .reading-page {
    width: 100%;
    max-width: 44rem;
    padding: 1.5rem 0;
    min-width: 0;
  }
  .reading-back {
    font-size: 0.78rem;
    color: hsl(var(--muted-foreground));
  }
  .article-header {
    padding: 1.25rem 0 1rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .article-prose {
    min-width: 0;
    margin-top: 1.5rem;
    overflow-wrap: anywhere;
  }
  .reading-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.78rem;
  }
  .reader-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .image-dialog {
    max-width: 96vw;
    max-height: 95dvh;
    padding: 2.75rem 1rem 1rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    color: hsl(var(--foreground));
  }
  .image-dialog::backdrop {
    background: rgb(0 0 0 / 0.65);
  }
  .image-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .image-preview :global(img) {
    display: block;
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .image-preview :global(p) {
    margin: 0.75rem 0 0;
    max-width: 100%;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  @media (min-width: 1101px) and (max-width: 1500px) {
    .tutorial-workspace {
      --left-rail-width: 14rem;
      --right-rail-width: 12rem;
    }
  }
  @media (max-width: 1100px) {
    .tutorial-workspace,
    .tutorial-workspace.has-contents {
      grid-template-columns: 1fr;
      grid-template-areas: 'navigation' 'main';
      gap: 0;
    }
    .tutorial-workspace.has-contents {
      grid-template-areas: 'navigation' 'contents' 'main';
    }
    .tutorial-workspace .reading-page {
      padding-top: 1.5rem;
    }
  }
  @media print {
    .tutorial-workspace {
      display: block;
    }
  }
</style>
