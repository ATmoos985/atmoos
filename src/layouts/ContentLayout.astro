---
import type { SiteMeta } from 'astro-pure/types'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  sectionUrl: string
  sectionLabel: string
  language?: string
  tutorial?: boolean
}

const { meta, sectionUrl, sectionLabel, language = 'zh-CN', tutorial = false } = Astro.props
---

<PageLayout {meta}>
  <div class:list={['reader-layout', { 'tutorial-workspace': tutorial }]}>
    <slot name='navigation' />
    <main id='main-content' class='reading-page'>
      <a class='reading-back text-link' href={sectionUrl}>← {sectionLabel}</a>
      <article lang={language}>
        <header class='article-header'>
          <slot name='header' />
        </header>
        <slot name='contents' />
        <div class:list={['article-prose prose text-base max-w-none', integ.typography.class]}>
          <slot />
        </div>
      </article>
      <slot name='adjacent' />
      <footer class='reading-footer'>
        <a class='text-link' href={sectionUrl}>← 返回{sectionLabel}</a>
        <a class='text-link' href='#main-content'>回到顶部 ↑</a>
      </footer>
      <p class='reader-status' role='status' aria-live='polite' data-reader-status></p>
      <dialog class='image-dialog' aria-label='图片预览'>
        <button type='button' class='image-close'>关闭 ×</button>
        <div class='image-preview'></div>
      </dialog>
    </main>
  </div>
</PageLayout>

<script>
  import '../scripts/reading'
  import '../scripts/diagrams'
</script>

<style>
  .reader-layout {
    min-width: 0;
  }
  .tutorial-workspace {
    display: grid;
    grid-template-columns: clamp(9rem, 12vw, 12rem) clamp(12rem, 17vw, 16rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 2.5vw, 3rem);
    align-items: start;
  }
  .tutorial-workspace .reading-page {
    max-width: 52rem;
    padding-top: 2rem;
  }
  .tutorial-workspace .article-header {
    padding-top: 1rem;
  }
  .reading-page {
    width: 100%;
    max-width: 44rem;
    padding: 1.5rem 0;
    min-width: 0;
  }
  .reading-back {
    font-size: 0.78rem;
    color: hsl(var(--muted-foreground));
  }
  .article-header {
    padding: 1.25rem 0 1rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .article-prose {
    min-width: 0;
    margin-top: 1.5rem;
    overflow-wrap: anywhere;
  }
  .reading-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.78rem;
  }
  .reader-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .image-dialog {
    max-width: 96vw;
    max-height: 95dvh;
    padding: 2.75rem 1rem 1rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    color: hsl(var(--foreground));
  }
  .image-dialog::backdrop {
    background: rgb(0 0 0 / 0.65);
  }
  .image-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .image-preview :global(img) {
    display: block;
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .image-preview :global(p) {
    margin: 0.75rem 0 0;
    max-width: 100%;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 1000px) {
    .tutorial-workspace {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tutorial-workspace .reading-page {
      padding-top: 1.5rem;
    }
  }
  @media print {
    .tutorial-workspace {
      display: block;
    }
  }
</style>
