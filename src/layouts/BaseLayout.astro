---
import Analytics from '@vercel/analytics/astro'

import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
}

const { meta } = Astro.props
const pathname = Astro.url.pathname
const isActive = (link: string) =>
  link === '/' ? pathname === '/' : pathname === link || pathname.startsWith(`${link}/`)
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {...meta} description={meta.description ?? config.description} />
  </head>
  <body class='site-body'>
    <a class='skip-link' href='#main-content'>跳到正文</a>
    <div class='paper-sheet'>
      <header class='site-header'>
        <a class='site-brand' href='/' aria-label='Atmoos 首页'
          >ATMOOS<span aria-hidden='true'>.</span></a
        >
        <nav class='site-nav' aria-label='主导航'>
          {
            config.header.menu?.map((item) => (
              <a href={item.link} aria-current={isActive(item.link) ? 'page' : undefined}>
                {item.title}
              </a>
            ))
          }
        </nav>
      </header>
      <div class='site-content'>
        <slot />
      </div>
      <footer class='site-footer'>
        <span>© {new Date().getFullYear()} Ami</span>
        <a href='/blog/rss.xml'>RSS 订阅</a>
      </footer>
    </div>
    <Analytics />
  </body>
</html>
